#!/usr/bin/env sh

# -----------------------------------------------------------------------------
# Script: run_as
# Description: Executes a command as a specified user, creating the user if needed
#              Uses UID to identify user, creates with default username if missing
# Usage: ./run_as <UID> <command> [args...]
# Arguments:
#   $1 - User ID (UID) - required
#   $2... - Command and its arguments to execute as the user
# Example: ./run_as 1001 ls -la /home
# Dependencies: Requires sourced files: _constants.sh, _messages.sh, _utils.sh
#               Assumes USERNAME constant is defined in _constants.sh
# Security Note: Creates users with disabled passwords if they don't exist
# -----------------------------------------------------------------------------

# Get the directory where the script is located
workdir="$(cd "$(dirname "$0")" && pwd)"  # Navigate to script's directory and get absolute path

# Get the project directory (same as workdir in this case, but allows for future flexibility)
project_dir=$(realpath "$workdir")         # Resolve any symlinks to get canonical path

# Source necessary library files for shared functionality
source "${workdir}/sources/_constants.sh"  # Contains constant values like default USERNAME
source "${workdir}/sources/_messages.sh"   # Contains message functions
source "${workdir}/sources/_utils.sh"      # Contains utility helper functions

# -----------------------------------------------------------------------------
# Function: get_or_create_user
# Description: Finds username by UID, creates user if it doesn't exist
#              Uses default username from constants for new users
# Parameters:
#   $1 - User ID (UID) to lookup or create
# Returns: Username associated with the UID (prints to stdout)
# -----------------------------------------------------------------------------
get_or_create_user() {
    # Capture the UID passed as first argument
    uid=$1

    # Try to get existing username from system's password database using UID
    # getent passwd "$uid" returns user entry, cut extracts first field (username)
    username=$(getent passwd "$uid" | cut -d: -f1)

    # Check if username was found (empty string means user doesn't exist)
    if [ -z "$username" ]; then
        # User doesn't exist - create a new system user
        # -D: Don't assign a password (creates disabled account)
        # -u "$uid": Set the specified UID
        # ${USERNAME}: Use default username from constants (assumes USERNAME is defined)
        adduser -D -u "$uid" ${USERNAME}

        # Retrieve the newly created username to verify creation
        username=$(getent passwd "$uid" | cut -d: -f1)
    fi

    # Output the username (used by command substitution in main script)
    echo "$username"
}

# Main script execution flow

# Get or create user based on first command-line argument (UID)
# Command substitution captures the output (username) into variable
username=$(get_or_create_user $1)

# Remove the first argument (UID) from argument list
# This leaves only the command and its arguments for later execution
shift

# Execute the remaining arguments as a command under the specified user account
# su -c "$*" $username
# - su: Switch user
# - -c: Execute the following command
# - "$*": All remaining arguments concatenated as a single command string
# - $username: User to switch to before executing command
# Note: Uses login shell (-) which sources the user's profile
su -c "$*" $username
