####################################################
#           Project Environment Settings           #
####################################################

# Specifies the project name used when running:
# "django-admin startproject ${PROJECT_NAME}"
PROJECT_NAME=config

# Directory where newly created Django apps will be placed.
APPS_DIRECTORY=apps

# Port number used by Django’s development server.
SERVER_PORT=9000

# Directory inside the container where Django collects static files
# (CSS, JavaScript, images) after running "collectstatic".
STATIC_ROOT=/assets/static

# Directory inside the container where user-uploaded media files are stored.
MEDIA_ROOT=/assets/media

# Default username used inside the container when creating a new user.
USERNAME=djansin
