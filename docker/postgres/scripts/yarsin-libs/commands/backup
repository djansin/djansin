# -----------------------------------------------------------------------------
# COMMAND METADATA
# -----------------------------------------------------------------------------
# This metadata is used by yarsin for command discovery and help display.
# Each field provides information about the command's purpose and usage.
# -----------------------------------------------------------------------------
declare -rA CMD_METADATA=(
    [name]="backup"
    [category]="database"
    [description]="PostgreSQL database backup utilities"
    [usage]="yarsin backup <subcommand> [OPTIONS]"
    [version]="1.0.0"
    [requires]="postgresql-client"
)


# =============================================================================
# EXECUTION GUARD
# =============================================================================
# Prevents direct execution of the command script. Ensures the command is only
# executed through the yarsin dispatcher, which provides the necessary
# environment and library loading.
#
# This guard checks two conditions:
#   1. Script is not being executed directly (sourced by yarsin)
#   2. Script is running within yarsin context (__YARSIN__ flag is set)
#
# Returns:
#   Non-zero exit code with error message if executed directly
# -----------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This command cannot be executed directly." >&2
    exit 1
elif [[ "${__YARSIN__}" != true ]]; then
    echo "Error: This command must be executed through yarsin dispatcher" >&2
    echo "Please use 'yarsin $(basename "${BASH_SOURCE[0]}") [OPTIONS]' instead." >&2
    exit 1
fi


# =============================================================================
# CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Strict Mode Configuration
# -----------------------------------------------------------------------------
# Enforces strict error handling to prevent silent failures and ensure
# predictable script behavior.
# -----------------------------------------------------------------------------
set -o errexit  # Exit immediately if any command fails
set -o pipefail # Propagate errors in pipelines
set -o nounset  # Treat unset variables as errors

# -----------------------------------------------------------------------------
# PostgreSQL Connection Configuration
# -----------------------------------------------------------------------------
# These environment variables are used by PostgreSQL client tools.
# They can be set externally or will use these defaults.
# -----------------------------------------------------------------------------

# Set the necessary environment variables for the database connection
export PGHOST="${POSTGRES_HOST:-localhost}"         # The host where the PostgreSQL database is running
export PGPORT="${POSTGRES_PORT:-5432}"              # The port number for connecting to the PostgreSQL database
export PGUSER="${POSTGRES_USER:-postgres}"          # The username for accessing the PostgreSQL database
export PGPASSWORD="${POSTGRES_PASSWORD:-}"          # The password for the PostgreSQL database user
export PGDATABASE="${POSTGRES_DB:-postgres}"        # The name of the default database to be used


# =============================================================================
# MAIN FUNCTION
#
# Main execution flow for the backup command.
#
# Description:
#   Provides PostgreSQL backup utilities with two main modes:
#   - dbms: Full PostgreSQL data directory backup (requires filesystem access)
#   - data: Individual database backup using pg_dump
#
# Arguments:
#   $@ - Subcommand and options
#
# Subcommands:
#   dbms         Full PostgreSQL data directory backup
#   data         Individual database backup
#
# Options:
#   -h, --help   Display this help message
#
# Environment Variables:
#   POSTGRES_HOST       Database host (default: localhost)
#   POSTGRES_PORT       Database port (default: 5432)
#   POSTGRES_USER       Database user (default: postgres)
#   POSTGRES_PASSWORD   Database password (required)
#   POSTGRES_DB         Default database (default: postgres)
#   BACKUP_ROOT         Root backup directory (default: /backup)
#   PGDATA              PostgreSQL data directory (default: /var/lib/postgresql/data)
#
# Returns:
#   0 - Backup completed successfully
#   1 - Invalid arguments
#   2 - Backup failed
# -----------------------------------------------------------------------------
main() {
    # -------------------------------------------------------------------------
    # Parse Command Line Arguments
    # -------------------------------------------------------------------------
    if [[ $# -eq 0 ]]; then
        show_help
        return 0
    fi

    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;

            dbms)
                shift
                _backup_dbms "$@"
                return $?
                ;;

            data)
                shift
                _backup_data "$@"
                return $?
                ;;

            *)
                alenaal_error "Invalid subcommand: '$1'"
                alenaal_suggestion "Available subcommands: dbms, data"
                alenaal_suggestion "Use 'yarsin backup --help' for usage information"
                return 1
                ;;
        esac
    done
}


