    # -------------------------------------------------------------------------
    alenaal_format "Arguments:" --section --info
    alenaal_format "PROJECT_NAME" --item --list --bold
    alenaal_format "Name of the Django project to create" --indent 4
    alenaal_format "Default: \${PROJECT_NAME:-configs}" --indent 4 --italic
    alenaal_newline

    # -------------------------------------------------------------------------
    # Environment Variables Section
    # -------------------------------------------------------------------------
    alenaal_format "Environment Variables:" --section --info
    alenaal_format "WORK_DIRECTORY" --item --list --bold
    alenaal_format "Base directory for project creation (REQUIRED)" --indent 4
    alenaal_format "Example: /home/user/projects" --indent 4 --italic

