# =============================================================================
# COMMAND FUNCTIONS
# =============================================================================
# Private helper functions for Docker Compose operations.
# These functions are prefixed with underscore to indicate internal use.
# =============================================================================

# -----------------------------------------------------------------------------
# Function: _handle_safe_operation
#
# Handles operations with user permission management (run-as).
#
# Args:
#   $1 - service: Target service name
#   $2 - command: Command to execute (with yarsin)
#
# Returns:
#   Exit code from the operation
# -----------------------------------------------------------------------------
_handle_safe_operation() {
    local service="$1"
    local command="run-as $(id -u) -- $2"

    _handle_operation "$service" "$command"
    return $?
}

# -----------------------------------------------------------------------------
# Function: _handle_operation
#
# Generic operation handler that auto-detects exec vs run.
#
# Args:
#   $1 - service: Target service name
#   $2 - command: Command to execute
#
# Returns:
#   Exit code from the operation
# -----------------------------------------------------------------------------
_handle_operation() {
    local service="$1"
    local command="$2"

    # Check if service is available
    if _check_service_status "${service}"; then
        # Service is running - use exec
        _handle_exec "$service" "$command"
    else
        # Service not running - use run
        _handle_run "$service" "$command"
    fi

    return $?
}

# -----------------------------------------------------------------------------
# Function: _handle_exec
#
# Executes a command in a running container.
#
# Args:
#   $1 - service: Service name
#   $2 - command: Command and arguments to execute
#
# Returns:
#   Exit code from the executed command
# -----------------------------------------------------------------------------
_handle_exec() {
    if [[ $# -lt 2 ]]; then
        alenaal_error "Usage: _handle_exec <service> <command>"
        return 1
    fi

    local service="$1"
    local command="$2"

    if ! _check_service_status "${service}"; then
        alenaal_error "Service '$service' is not running"
        alenaal_suggestion "Start the service first: docker compose -f ${COMPOSE_FILE} up -d $service"
        return 1
    fi

    docker compose -f "${COMPOSE_FILE}" exec "${service}" bash -c "$command"
    return $?
}

# -----------------------------------------------------------------------------
# Function: _handle_run
#
# Runs a command in a new container.
#
# Args:
#   $1 - service: Service name
#   $2 - command: Command and arguments to run
#
# Returns:
#   Exit code from the executed command
# -----------------------------------------------------------------------------
_handle_run() {
    if [[ $# -lt 2 ]]; then
        alenaal_error "Usage: _handle_run <service> <command>"
        return 1
    fi

    local service="$1"
    local command="$2"

    docker compose -f "${COMPOSE_FILE}" run --rm "${service}" bash -c "$command"
    return $?
}

# -----------------------------------------------------------------------------
# Function: _check_service_status
#
# Checks if a Docker Compose service is running.
#
# Args:
#   $1 - service: Service name to check
#
# Returns:
#   0 if service is running, 1 otherwise
# -----------------------------------------------------------------------------
_check_service_status() {
    local service="$1"

    if [[ -z "$service" ]]; then
        return 1
    fi

    # Check if service is in running state
    if docker compose -f "${COMPOSE_FILE}" ps --services --filter "status=running" 2>/dev/null | grep -q "^${service}$"; then
        return 0
    fi

    return 1
}


# =============================================================================
# METADATA HANDLER LOADING
# =============================================================================
# When sourced by yarsin, load metadata handling functions.
# This provides yarsin with access to metadata functions without
# executing the main command logic. The handler provides:
#   - metadata() - Returns all command metadata as key-value pairs
#   - metadata_value() - Returns specific metadata field value
#
# The "$@" passes any arguments through to the handler, though typically
# none are needed for metadata operations.
# -----------------------------------------------------------------------------
source "${YARSIN_CORE_PATH}/includes/metadata" "$@"
