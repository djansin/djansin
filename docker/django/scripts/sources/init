#!/usr/bin/env sh

set -o errexit  # Exit script immediately if a command fails
set -o pipefail # Exit script when a command in a pipeline fails

convert_slashed_path_to_dot "apps/my_apps"

exit 0

# Load scaffold helper functions
source "${workdir}/sources/_scaffold"

# Initialize a new Django project with environment-based configuration structure
#
# This function creates a Django project with a structured configuration approach
# that separates settings and URLs by environment (development, testing, production).
# It establishes a clean, maintainable foundation for multi-environment deployments.
#
# Arguments:
#   $1: Project name (optional, defaults to PROJECT_NAME variable)
#   $2: Working directory (optional, defaults to WORK_DIRECTORY variable)
#
# Outputs:
#   - A Django project with environment-specific configuration structure
#   - Base settings/URLs files with environment-specific extensions
#   - Success/failure messages for each step
#
# Returns:
#   0 on success, non-zero on critical failure
#
# Example:
#   init "myproject" "/path/to/project"
#   init  # Uses defaults from PROJECT_NAME and WORK_DIRECTORY
init() {
    local project_name="${1:-$PROJECT_NAME}"
    local work_dir="${2:-$WORK_DIRECTORY}"

    # Validate inputs
    if [[ -z "$project_name" ]]; then
        message_error "Project name is required. Set PROJECT_NAME or pass as argument."
        return 1
    fi

    if [[ -z "$work_dir" ]]; then
        message_error "Work directory is required. Set WORK_DIRECTORY or pass as argument."
        return 1
    fi

    # Create the base Django project structure
    message_info "Initializing Django project: ${project_name} in ${work_dir}"
    django-admin startproject "${project_name}" "${work_dir}" || {
        message_error "Failed to create Django project: ${project_name}"
        exit 1
    }
    message_success "Django project skeleton created"

    # ------------------------------------------------------------
    # SETTINGS CONFIGURATION
    # ------------------------------------------------------------

    # Create settings directory and organize configuration files
    message_info "Setting up environment-based configuration structure..."

    # Create settings directory with __init__.py for Python package
    if mkdir -p "${work_dir}/${project_name}/settings"; then
        # Create __init__.py to make settings a proper Python package
        touch "${work_dir}/${project_name}/settings/__init__.py" || {
            message_warning "Could not create __init__.py in settings directory"
            exit 1
        }

        # Move the default settings.py to base.py as our foundation
        if [[ -f "${work_dir}/${project_name}/settings.py" ]]; then
            mv "${work_dir}/${project_name}/settings.py" "${work_dir}/${project_name}/settings/base.py" || {
                message_error "Failed to move settings.py to base.py"
                exit 1
            }
            message_success "Base settings file created: ./${project_name}/settings/base.py"
        fi

        # Generate environment-specific settings files
        message_info "Creating environment-specific settings files..."

        (generate_setting_file "production" && 
            message_success "Production settings created: ./${project_name}/settings/production.py") || 
            (message_warning "Failed to create production settings" && exit 1 )

        (generate_setting_file "development" && 
            message_success "Development settings created: ./${project_name}/settings/development.py") ||
            (message_warning "Failed to create development settings" && exit 1 )

        (generate_setting_file "testing" && 
            message_success "Testing settings created: ./${project_name}/settings/testing.py") ||
            (message_warning "Failed to create testing settings" && exit 1 )
    else
        message_error "Failed to create settings directory structure"
        return 1
    fi

    # ------------------------------------------------------------
    # URL CONFIGURATION
    # ------------------------------------------------------------
    
    # Create URLs directory and organize routing files
    message_info "Setting up environment-based URL structure..."
    
    # Create URLs directory with __init__.py for Python package
    if mkdir -p "${work_dir}/${project_name}/urls"; then
        # Create __init__.py to make urls a proper Python package
        touch "${work_dir}/${project_name}/urls/__init__.py" || {
            message_warning "Could not create __init__.py in urls directory"
            exit 1
        }
        
        # Move the default urls.py to base.py as our routing foundation
        if [[ -f "${project_name}/urls.py" ]]; then
            mv "${work_dir}/${project_name}/urls.py" "${work_dir}/${project_name}/urls/base.py" || {
                message_error "Failed to move urls.py to base.py"
                exit 1
            }
            message_success "Base URL configuration created: ./${project_name}/urls/base.py"
        fi
        
        # Generate environment-specific URL configuration files
        message_info "Creating environment-specific URL configurations..."

        (generate_urls_file "production" && 
             message_success "Production URLs created: ./${project_name}/urls/production.py") || 
            (message_warning "Failed to create production URLs" && exit 1 )

        (generate_urls_file "development" && 
             message_success "Development URLs created: ./${project_name}/urls/development.py") || 
            (message_warning "Failed to create development URLs" && exit 1 )
        
        (generate_urls_file "testing" && 
             message_success "testing URLs created: ./${project_name}/urls/testing.py") || 
            (message_warning "Failed to create testing URLs" && exit 1 )
    else
        message_error "Failed to create URLs directory structure"
        exit 1
    fi

    # ------------------------------------------------------------
    # FINALIZATION
    # ------------------------------------------------------------

    # Provide final instructions
    message_newline
     message_newline
    message_table header "Django project '${project_name}' initialized successfully!"
    message_table row "Project Structure Created:"
    message_table row "./${project_name}/"
    message_table row "├─ settings/"
    message_table row "│ ├─ __init__.py"
    message_table row "│ ├─ base.py          # Foundation for all environments"
    message_table row "│ ├─ production.py    # Production configuration"
    message_table row "│ ├─ development.py   # Development configuration"
    message_table row "│ └─ testing.py       # Testing configuration"
    message_table row "└─urls/"
    message_table row "  ├─ __init__.py"
    message_table row "  ├─ base.py          # Base URL patterns"
    message_table row "  ├─ production.py    # Production URLs"
    message_table row "  ├─ development.py   # Development URLs"
    message_table row "  └─ testing.py       # Testing URLs"
    message_table row "..."
    message_table footer
    message_newline
    message_suggestion "Quick Start Guide:"
    message -l 2 "1. Fix project root path in ./settings/base.py:"
    message -l 3 "   BASE_DIR = Path(__file__).resolve().parent.parent.parent"
    message -l 2 "2. Configure ALLOWED_HOSTS for development/production:"
    message -l 3 "   • development.py: ALLOWED_HOSTS = [\"*\"] (for local testing)"
    message -l 3 "   • production.py: Update with actual domain before deployment"
    message -l 2 "3. Start services:"
    message -l 3 "   $ make up"
    message -l 2 "4. Access application:"
    message -l 3 "   http://localhost:9000"
    message -l 2 "5. Documentation:"
    message -l 3 "   https://gitlab.com/amoosin/djansin"
        
    return 0
}
 
 init "$@"