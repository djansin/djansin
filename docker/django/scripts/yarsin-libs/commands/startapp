# =============================================================================
# COMMAND FUNCTIONS
# =============================================================================
# Private helper functions for creating and configuring applications.
# These functions are prefixed with underscore to indicate internal use.
# =============================================================================

# -----------------------------------------------------------------------------
# Function: _create_single_app
#
# Creates a single Django application and fixes its AppConfig.
#
# Args:
#   $1 - app_name: Name of the application to create
#   $2 - base_dir: Base directory where the app should be created
#
# Returns:
#   0 - Application created and configured successfully
#   1 - Application creation failed
#   2 - AppConfig fix failed
# -----------------------------------------------------------------------------
_create_single_app() {
    local app_name="$1"
    local base_dir="$2"
    local app_path="${base_dir}/${app_name}"

    # Check if app already exists
    if [[ -d "${app_path}" ]]; then
        alenaal_warning "Application '${app_name}' already exists at: ${app_path}"
        alenaal_suggestion "Use a different name or remove the existing directory"
        return 1
    fi

    # Create the app directory
    if ! mkdir -p "${app_path}"; then
        alenaal_error "Failed to create directory for app '${app_name}'"
        return 1
    fi

    # Run django-admin startapp
    if ! django-admin startapp "${app_name}" "${app_path}" 2>/dev/null; then
        alenaal_error "Failed to create app '${app_name}' using django-admin"
        # Clean up the directory we created
        rmdir "${app_path}" 2>/dev/null || true
        return 1
    fi

    alenaal_success "App '${app_name}' created successfully."

    # Fix AppConfig.name
    if ! _fix_appconfig_name "${app_name}" "${app_path}"; then
        alenaal_warning "App '${app_name}' created but AppConfig.name could not be updated."
        alenaal_suggestion "Manually update apps.py to set name = '${base_dir##*/}.${app_name}'"
        return 2
    fi

    alenaal_success "Updated AppConfig.name → '${base_dir##*/}.${app_name}'" --indent 2
    return 0
}

# -----------------------------------------------------------------------------
# Function: _fix_appconfig_name
#
# Updates the AppConfig.name in an app's apps.py file.
#
# Args:
#   $1 - app_name: Name of the application
#   $2 - app_dir: Path to the application directory
#
# Returns:
#   0 - AppConfig.name updated successfully
#   1 - apps.py not found or could not be modified
# -----------------------------------------------------------------------------
_fix_appconfig_name() {
    local app_name="$1"
    local app_dir="$2"
    local apps_py="${app_dir}/apps.py"
    local apps_dir_name="$(basename "$(dirname "${app_dir}")")"

    # Ensure apps.py exists
    if [[ ! -f "${apps_py}" ]]; then
        alenaal_error "apps.py not found in ${app_dir}. Cannot update AppConfig.name."
        return 1
    fi

    # Create backup before modifying
    local backup_file="${apps_py}.bak"
    cp "${apps_py}" "${backup_file}"

    # Safely replace the 'name = "<something>"' line
    # This handles various formatting: name = "blog", name='blog', name = 'blog', etc.
    if ! sed -i \
        "s/^[[:space:]]*name[[:space:]]*=[[:space:]]*['\"][^'\"]*['\"]/    name = \"${apps_dir_name}.${app_name}\"/" \
        "${apps_py}"; then
        
        # Restore from backup if sed failed
        mv "${backup_file}" "${apps_py}"
        alenaal_error "Failed to update AppConfig.name in ${apps_py}"
        return 1
    fi

    # Remove backup file on success
    rm -f "${backup_file}"
    return 0
}


