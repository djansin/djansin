#!/usr/bin/env bash

# -----------------------------------------------------------------------------
# Script: start-flower
# Description: Waits for Celery workers to become available, then starts Celery Flower
#              Flower is a web-based monitoring tool for Celery clusters
# Usage: ./start-flower
# Environment Variables Required:
#   CELERY_BROKER_URL - Broker URL (e.g., redis://redis:6379/0)
#   CELERY_FLOWER_USER - Username for Flower HTTP basic authentication
#   CELERY_FLOWER_PASSWORD - Password for Flower HTTP basic authentication
# Dependencies: Requires sourced files: _constants.sh, _messages.sh, _utils.sh
#               Assumes Celery app is configured in config module
# -----------------------------------------------------------------------------

# Enable strict error handling for more robust scripts
set -o errexit  # Exit script immediately if any command exits with non-zero status
set -o nounset  # Exit script if any variable is referenced before being set

# Define the project and workdir directory
workdir="$(cd "$(dirname "$0")" && pwd)"  # Get script's directory by changing to it then printing path
project_dir=$(realpath "$workdir")         # Get canonical absolute path (resolves symlinks)

# Source necessary library files for shared functionality
source "${workdir}/sources/_constants.sh"  # Contains constant values and configuration
source "${workdir}/sources/_messages.sh"   # Contains formatted output functions (message_bold, message_success, etc.)
source "${workdir}/sources/_utils.sh"      # Contains utility helper functions

# -----------------------------------------------------------------------------
# Function: worker_ready
# Description: Checks if Celery workers are responsive by sending a ping command
#              Uses celery inspect ping which queries workers and returns response
# Returns: 0 (success) if workers respond, non-zero if workers are unavailable
# Note: The -A flag specifies the Celery application module (config)
# -----------------------------------------------------------------------------
worker_ready() {
    # Ping all Celery workers in the cluster
    # -A config: Use Celery app defined in config module
    # inspect ping: Sends ping to workers, returns success if at least one responds
    celery -A config inspect ping
}

# -----------------------------------------------------------------------------
# Main execution: Wait for workers, then start Flower
# -----------------------------------------------------------------------------

# Keep checking until celery workers are ready using until loop
# until loop runs WHILE the condition is FALSE (opposite of while)
until worker_ready; do
    # Display waiting message with bold formatting
    message_bold "Waiting for Celery workers to become available..."

    # Wait 1 second before retrying to avoid tight loop
    sleep 1
done

# Display success message once workers are available
message_success "Celery workers are now available and ready to process tasks."

# Start Celery Flower monitoring dashboard with authentication
# -A config: Use Celery app defined in config module
# flower: Start Flower web interface
# --broker="${CELERY_BROKER_URL}": Specify message broker URL (from environment)
# --basic_auth="${CELERY_FLOWER_USER}:${CELERY_FLOWER_PASSWORD}": Enable HTTP basic auth
# Note: Flower will run in foreground, blocking until terminated
celery -A config flower \
    --broker="${CELERY_BROKER_URL}" \
    --basic_auth="${CELERY_FLOWER_USER}:${CELERY_FLOWER_PASSWORD}"
