# -----------------------------------------------------------------------------
# Function: _rename_backup
#
# Renames a backup file.
#
# Args:
#   $1 - old_name: Current backup name
#   $2 - new_name: New backup name
# -----------------------------------------------------------------------------
_rename_backup() {
    local old_name=""
    local new_name=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --help)
                show_help
                return 0
                ;;
            
            -*)
                alenaal_error "Unknown rename option: $1"
                return 1
                ;;
            
            *)
                if [[ -z "$old_name" ]]; then
                    old_name="$1"
                elif [[ -z "$new_name" ]]; then
                    new_name="$1"
                else
                    alenaal_error "Unexpected argument: $1"
                    return 1
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$old_name" ]]; then
        alenaal_error "No source backup name provided"
        alenaal_suggestion "Usage: yarsin bumng rename <old_name> <new_name>"
        return 1
    fi

    if [[ -z "$new_name" ]]; then
        alenaal_error "No destination backup name provided"
        alenaal_suggestion "Usage: yarsin bumng rename <old_name> <new_name>"
        return 1
    fi

    # Search for backup in both directories
    local old_path=""
    local target_dir=""
    if [[ -f "${DBMS_BACKUP_PATH}/${old_name}" ]]; then
        old_path="${DBMS_BACKUP_PATH}/${old_name}"
        target_dir="${DBMS_BACKUP_PATH}"
    elif [[ -f "${DATA_BACKUP_PATH}/${old_name}" ]]; then
        old_path="${DATA_BACKUP_PATH}/${old_name}"
        target_dir="${DATA_BACKUP_PATH}"
    else
        alenaal_error "Backup not found: $old_name"
        alenaal_suggestion "Use 'yarsin bumng list' to see available backups"
        return 2
    fi

    local new_path="${target_dir}/${new_name}"

    # Check if destination already exists
    if [[ -f "$new_path" ]]; then
        alenaal_error "Destination already exists: $new_name"
        alenaal_suggestion "Choose a different name or delete the existing backup first"
        return 2
    fi

    # Show backup details
    alenaal_newline
    alenaal_format "Renaming:" --color blue --bold
    _list_backups_single "$old_path"
    alenaal_format "To:" --indent 2 --bold --color red
    printf "    \033[91m•\033[0m \033[1;33m%s\033[0m\n" "$new_name"
    alenaal_newline

    # Confirm rename
    alenaal_ask "Proceed with rename? (yes/no): " --indent 2
    read -r confirmation

    if [[ "$confirmation" != "yes" ]]; then
        alenaal_newline
        alenaal_cancel "Rename cancelled" --bold
        alenaal_newline
        return 0
    fi

    # Rename the file
    if mv "$old_path" "$new_path"; then
        alenaal_newline
        alenaal_complete "Backup renamed successfully" --bold
        alenaal_format "Old: $old_name" --indent 2 --color blue
        alenaal_format "New: $new_name" --indent 2 --color blue
        alenaal_newline
        return 0
    else
        alenaal_error "Failed to rename backup: $old_name"
        return 2
    fi
}


# =============================================================================
# METADATA HANDLER LOADING
# =============================================================================
# When sourced by yarsin, load metadata handling functions.
# This provides yarsin with access to metadata functions without
# executing the main command logic. The handler provides:
#   - metadata() - Returns all command metadata as key-value pairs
#   - metadata_value() - Returns specific metadata field value
#
# The "$@" passes any arguments through to the handler, though typically
# none are needed for metadata operations.
# -----------------------------------------------------------------------------
source "${YARSIN_CORE_PATH}/includes/metadata" "$@"
