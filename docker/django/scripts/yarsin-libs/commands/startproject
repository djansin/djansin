    alenaal_format "Note: For multi-environment settings structure, use:" --item --italic
    alenaal_format "yarsin init ${project_name:-PROJECT_NAME}" --item --icon "⇢" --indent 4 --bold
    alenaal_newline

    # -------------------------------------------------------------------------
    # Next Steps Section
    # -------------------------------------------------------------------------
    alenaal_format "Next Steps:" --section --tip
    alenaal_format "After creating your project, you can:" --item

    alenaal_format "1. Set up multi-environment settings (recommended):" --item --list --indent 4
    alenaal_format "yarsin init" --indent 6 --bold

    alenaal_format "2. Create Django apps:" --item --list --indent 4
