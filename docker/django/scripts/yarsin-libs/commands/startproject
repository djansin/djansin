    alenaal_format "Default: 'configs'" --indent 4 --italic
    alenaal_newline

    # -------------------------------------------------------------------------
    # Examples Section
    # -------------------------------------------------------------------------
    alenaal_format "Examples:" --section --example

    alenaal_format "Basic usage with positional argument" --subsection --italic
    alenaal_format "export WORK_DIRECTORY=~/projects" --item --icon "⇢" --indent 4 --bold
    alenaal_format "yarsin startproject myblog" --item --icon "⇢" --indent 4 --bold
    alenaal_format "Creates project at ~/projects/myblog" --indent 5 --italic
    alenaal_newline

    alenaal_format "Using --name option" --subsection --italic
    alenaal_format "export WORK_DIRECTORY=/app" --item --icon "⇢" --indent 4 --bold
    alenaal_format "yarsin startproject --name backend" --item --icon "⇢" --indent 4 --bold
    alenaal_format "Creates project at /app/backend" --indent 5 --italic
    alenaal_newline

    alenaal_format "Using environment variable" --subsection --italic
    alenaal_format "export WORK_DIRECTORY=/opt/django" --item --icon "⇢" --indent 4 --bold
    alenaal_format "export PROJECT_NAME=api" --item --icon "⇢" --indent 4 --bold
    alenaal_format "yarsin startproject" --item --icon "⇢" --indent 4 --bold
    alenaal_format "Creates project at /opt/django/api" --indent 5 --italic
    alenaal_newline

    alenaal_format "Custom project name and directory" --subsection --italic
    alenaal_format "export WORK_DIRECTORY=/home/user/workspace" --item --icon "⇢" --indent 4 --bold
    alenaal_format "yarsin startproject ecommerce" --item --icon "⇢" --indent 4 --bold
    alenaal_format "Creates project at /home/user/workspace/ecommerce" --indent 5 --italic
    alenaal_newline

    alenaal_format "With error handling example" --subsection --italic
    alenaal_format "export WORK_DIRECTORY=/invalid/path" --item --icon "⇢" --indent 4 --bold
    alenaal_format "yarsin startproject myapp" --item --icon "⇢" --indent 4 --bold
    alenaal_format "# Error: WORK_DIRECTORY directory does not exist" --indent 5 --italic
    alenaal_format "# The command will create the directory automatically" --indent 5 --italic
    alenaal_newline

    # -------------------------------------------------------------------------
    # Generated Structure Section
    # -------------------------------------------------------------------------
    alenaal_format "Generated Structure:" --section --example
    alenaal_format "The command creates the standard Django project structure:" --item

    alenaal_format "PROJECT_NAME/" --item --list --bold --indent 4
    alenaal_format "├─ manage.py" --indent 6
    alenaal_format "├─ PROJECT_NAME/" --indent 6
    alenaal_format "│  ├─ __init__.py" --indent 6
    alenaal_format "│  ├─ asgi.py" --indent 6
    alenaal_format "│  ├─ settings.py" --indent 6
    alenaal_format "│  ├─ urls.py" --indent 6
    alenaal_format "│  └─ wsgi.py" --indent 6
