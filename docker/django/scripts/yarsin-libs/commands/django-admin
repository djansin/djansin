#!/usr/bin/env bash

# =============================================================================
# Command: django-admin
# Description: Django management commands interface
#
# Author: Mohammad Ali Amini
# Date: 2026
# =============================================================================

# -----------------------------------------------------------------------------
# Command Metadata
# -----------------------------------------------------------------------------
# This metadata is used by yarsin for command discovery and help display.
# Each field provides information about the command's purpose and usage.
# -----------------------------------------------------------------------------
declare -rA CMD_METADATA=(
    [name]="django-admin"
    [category]="framework"
    [description]="Django management commands interface"
    [usage]="yarsin django-admin <subcommand> [OPTIONS]"
    [version]="1.0.0"
    [requires]="python django-admin"
)


# =============================================================================
# EXECUTION GUARD
# =============================================================================
# Prevents direct execution of the command script. Ensures the command is only
# executed through the yarsin dispatcher, which provides the necessary
# environment and library loading.
#
# This guard checks two conditions:
#   1. Script is not being executed directly (sourced by yarsin)
#   2. Script is running within yarsin context (__YARSIN__ flag is set)
#
# Returns:
#   Non-zero exit code with error message if executed directly
# -----------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This command cannot be executed directly." >&2
    exit 1
elif [[ "${__YARSIN__}" != true ]]; then
    echo "Error: This command must be executed through yarsin dispatcher" >&2
    echo "Please use 'yarsin $(basename "${BASH_SOURCE[0]}") [OPTIONS]' instead." >&2
    exit 1
fi


# =============================================================================
# MAIN FUNCTION
#
# Main execution flow for the django-admin command.
#
# Description:
#   Acts as a thin wrapper around Django's management commands. Validates
#   that the current directory contains a valid Django project, then passes
#   all arguments through to django-admin. Provides helpful error messages
#   with links to appropriate documentation when commands fail.
#
# Arguments:
#   $@ - All arguments are passed directly to django-admin
#
# Environment Variables:
#   WORK_DIRECTORY        Base directory for the Django project
#   DJANGO_SETTINGS_MODULE Dotted path to Django settings module
#
# Returns:
#   0 - Command executed successfully
#   1 - django-admin command failed
#   2 - Settings module file not found
# -----------------------------------------------------------------------------
main() {
    # -------------------------------------------------------------------------
    # Validate Django project structure
    # -------------------------------------------------------------------------
    # Ensures the Django settings module exists at the expected location
    # before attempting to run any management commands. This prevents
    # cryptic errors from django-admin and provides user-friendly guidance.
    # -------------------------------------------------------------------------
    if ! check_settings_file; then
        (
            source "${YARSIN_CORE_PATH}/helpers/messages"
            settings_module_not_found
        )
        return 2
    fi

    # -------------------------------------------------------------------------
    # Execute Django Command
    # -------------------------------------------------------------------------
    # Pass all remaining arguments directly to django-admin. This allows
    # any Django management command to be run through yarsin.
    # -------------------------------------------------------------------------
    django-admin "$@"
    local django_exit_code=$?

    # -------------------------------------------------------------------------
    # Handle Command Failure
    # -------------------------------------------------------------------------
    # If django-admin fails, provide a helpful error message with a link to
    # the appropriate version of the Django documentation. This improves the
    # user experience by pointing them to the correct resources.
    # -------------------------------------------------------------------------
    if [[ $django_exit_code -ne 0 ]]; then
        local ver
        ver="$(get_django_version)"
        
        alenaal_error "An error occurred while running django-admin."
        alenaal_suggestion "For guidance, refer to the Django documentation:"
        alenaal_format "https://docs.djangoproject.com/en/${ver}/ref/django-admin/" --indent 2 --color cyan

        return $django_exit_code
    fi

    return 0
}


# =============================================================================
# METADATA HANDLER LOADING
# =============================================================================
# When sourced by yarsin, load metadata handling functions.
# This provides yarsin with access to metadata functions without
# executing the main command logic. The handler provides:
#   - metadata() - Returns all command metadata as key-value pairs
#   - metadata_value() - Returns specific metadata field value
#
# The "$@" passes any arguments through to the handler, though typically
# none are needed for metadata operations.
# -----------------------------------------------------------------------------
source "${YARSIN_CORE_PATH}/includes/metadata" "$@"
