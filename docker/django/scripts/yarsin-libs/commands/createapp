# =============================================================================
# COMMAND FUNCTIONS
# =============================================================================
# Private helper functions for creating and configuring applications.
# These functions are prefixed with underscore to indicate internal use.
# =============================================================================

# -----------------------------------------------------------------------------
# Function: _get_app_dir
#
# Gets the default directory for an app type.
#
# Args:
#   $1 - app_type: Type of app (default, extras, package)
#
# Returns:
#   Prints the directory path for the app type
# -----------------------------------------------------------------------------
_get_app_dir() {
    local app_type="$1"
    
    if [[ -z "$app_type" ]]; then
        alenaal_error "App type cannot be empty"
        return 1
    fi

    local app_dir="${APP_DIRECTORIES[$app_type]:-}"

    if [[ -z "$app_dir" ]]; then
        alenaal_warning "Unknown app type '${app_type}', using default directory"
        app_dir="${APP_DIRECTORIES[default]:-apps}"
    fi

    echo "$app_dir"
}

# -----------------------------------------------------------------------------
# Function: _normalize_path
#
# Validates and normalizes file paths with strict security checks.
#
# Features:
#   - Validates all relative path components
#   - Rejects unsafe path traversals (../, .., etc.)
#   - Normalizes ./ prefix removal
#   - Removes trailing slashes
#   - Returns clean path or exits with error
#
# Args:
#   $1 - path: Path to normalize
#
# Returns:
#   Prints normalized path on success, exits with error on failure
# -----------------------------------------------------------------------------
_normalize_path() {
    local original_path="$1"
    local normalized_path=""

    # -------------------------------------------------------------------------
    # Phase 1: Input Validation and Sanitization
    # -------------------------------------------------------------------------
    if [[ -z "$original_path" ]]; then
        alenaal_error "No path provided to _normalize_path()"
        return 1
    fi

    # Remove whitespace
    local clean_path
    clean_path=$(echo "$original_path" | tr -d '[:space:]')
    
    if [[ -z "$clean_path" ]]; then
        alenaal_error "Path is empty after removing whitespace: '$original_path'"
        return 1
    fi

    # -------------------------------------------------------------------------
    # Phase 2: Detect and Reject Unsafe Path Traversals
    # -------------------------------------------------------------------------
    case "$clean_path" in
        ../*|*/../*|*/..|..)
            alenaal_error "Unsafe path traversal detected (parent directory reference): '$original_path'"
            return 1
            ;;
    esac

    if echo "$clean_path" | grep -q '\.\.'; then
        alenaal_error "Path contains illegal '..' sequence: '$original_path'"
        return 1
    fi

    # -------------------------------------------------------------------------
    # Phase 3: Remove Leading ./ Prefix
    # -------------------------------------------------------------------------
    normalized_path="$clean_path"

    case "$normalized_path" in
        ./*)
            normalized_path="${normalized_path#./}"
            ;;
    esac

    # Handle special case: "." or empty
    if [[ "$normalized_path" == "." || -z "$normalized_path" ]]; then
        echo ""
        return 0
    fi

    # -------------------------------------------------------------------------
    # Phase 4: Validate Path Components
    # -------------------------------------------------------------------------
    if echo "$normalized_path" | grep -q '//'; then
        alenaal_error "Path contains consecutive slashes: '$original_path'"
        return 1
    fi

    if echo "$normalized_path" | grep -q '/\./'; then
        alenaal_error "Path contains redundant '/./' pattern: '$original_path'"
        return 1
    fi

    # Check for invalid filesystem characters
    local invalid_chars
    invalid_chars=$(echo "$normalized_path" | grep -o '[<>:"|?*\\]' | head -n1)
    if [[ -n "$invalid_chars" ]]; then
        alenaal_error "Path contains invalid character '$invalid_chars': '$original_path'"
        return 1
    fi

    # Reject absolute paths
    case "$normalized_path" in
        /*)
            alenaal_error "Absolute paths are not allowed: '$original_path'"
            return 1
            ;;
    esac

    # -------------------------------------------------------------------------
    # Phase 5: Remove Trailing Slashes
    # -------------------------------------------------------------------------
    while [[ "$normalized_path" == */ ]]; do
        normalized_path="${normalized_path%/}"
    done

    if [[ -z "$normalized_path" ]]; then
        alenaal_error "Path became empty after removing trailing slashes: '$original_path'"
        return 1
    fi

    # -------------------------------------------------------------------------
    # Phase 6: Final Validation
    # -------------------------------------------------------------------------
    local IFS='/'
    for component in $normalized_path; do
        if [[ -z "$component" ]]; then
            continue
        fi

        case "$component" in
            .|..)
                alenaal_error "Invalid path component '$component' in: '$original_path'"
                return 1
                ;;
            .*)
                alenaal_error "Hidden paths are not allowed: '$original_path'"
                return 1
                ;;
        esac
    done

    echo "$normalized_path"
}

# -----------------------------------------------------------------------------
# Function: _convert_slashed_path_to_dot
#
# Converts filesystem paths to Python module dot notation.
#
# Description:
#   - Uses _normalize_path() for initial validation and cleanup
#   - Converts forward slashes (/) to dots (.) for Python imports
#   - Handles edge cases like duplicate dots and leading/trailing dots
#
# Args:
#   $1 - path: Filesystem path to convert
#
# Returns:
#   Prints Python module dot notation
# -----------------------------------------------------------------------------
_convert_slashed_path_to_dot() {
    if [[ -z "$1" ]]; then
        return 0
    fi

    local input_path="$1"
    local normalized_path

    normalized_path="$(_normalize_path "$input_path")" || return 1

    # Convert slashes to dots
    local dot_path
    dot_path=$(echo "$normalized_path" | tr '/' '.')

    # Remove duplicate consecutive dots
    if command -v sed >/dev/null 2>&1; then
        dot_path=$(echo "$dot_path" | sed 's/\.\.\+/./g')
    else
        while echo "$dot_path" | grep -q '\.\.'; do
            dot_path=$(echo "$dot_path" | sed 's/\.\././g' 2>/dev/null || echo "$dot_path")
        done
    fi

    # Clean up leading/trailing dots
    case "$dot_path" in
        ..*) ;;  # Keep for relative imports
        .*) dot_path="${dot_path#.}" ;;
    esac

    dot_path="${dot_path%.}"

    echo "$dot_path"
}

# -----------------------------------------------------------------------------
# Function: _to_lower
#
# Converts a string to lowercase.
#
# Args:
#   $1 - input: String to convert
#
# Returns:
#   Prints lowercase version of the input string
# -----------------------------------------------------------------------------
_to_lower() {
    local input="$1"
    echo "$input" | tr '[:upper:]' '[:lower:]'
}

# -----------------------------------------------------------------------------
# Function: _to_capitalize
#
# Capitalizes the first letter of a string.
#
# Args:
#   $1 - input: String to capitalize
#
# Returns:
#   Prints string with first letter capitalized
# -----------------------------------------------------------------------------
_to_capitalize() {
    local input="$1"
    echo "$(tr '[:lower:]' '[:upper:]' <<<"${input:0:1}")${input:1}"
}

# -----------------------------------------------------------------------------
# Function: _append_path
#
# Safely appends a subpath to a root path.
#
# Args:
#   $1 - root: Root directory path
#   $2 - path: Subpath to append (can be empty)
#
# Returns:
#   Prints combined path
# -----------------------------------------------------------------------------
_append_path() {
    local root="$1"
    local path="$2"

    if [[ -n "$path" ]]; then
        echo "${root}/${path}"
    else
        echo "$root"
    fi
}

# -----------------------------------------------------------------------------
# Function: _get_file_dir
#
# Constructs the full file path for an application.
#
# Args:
#   $1 - app_name: Application name
#   $2 - root_dir: Root directory path
#   $3 - apps_dir: Apps directory subpath
#
# Returns:
#   Prints complete file path
# -----------------------------------------------------------------------------
_get_file_dir() {
    local app_name="$1"
    local root_dir="$2"
    local apps_dir="$3"

    local base_path
    base_path="$(_append_path "$root_dir" "$apps_dir")"
    echo "${base_path}/${app_name}"
}

# -----------------------------------------------------------------------------
# Function: _get_app_config_name
#
# Generates a configuration name for an application.
#
# Args:
#   $1 - app_name: Application name
#   $2 - apps_dir: Apps directory path (optional)
#
# Returns:
#   Prints configuration name with directory prefix in dot notation
# -----------------------------------------------------------------------------
_get_app_config_name() {
    local app_name="$1"
    local apps_dir="$2"

    if [[ -n "${apps_dir}" ]]; then
        local dir_prefix
        dir_prefix="$(_convert_slashed_path_to_dot "$apps_dir")"
        echo "${dir_prefix}.${app_name}"
    else
        echo "$app_name"
    fi
}

# -----------------------------------------------------------------------------
# Function: _create_single_app
#
# Creates a complete Django application structure with all standard files.
#
# Args:
#   $1 - app_name: Application name (lowercase)
#   $2 - root_dir: Root directory path
#   $3 - apps_dir: Apps directory subpath
#
# Returns:
#   0 - Successfully created the Django app
#   1 - App directory already exists
# -----------------------------------------------------------------------------
_create_single_app() {
    local app_name="$1"
    local root_dir="$2"
    local apps_dir="$3"

    local app_path
    app_path="$(_append_path "$root_dir" "$apps_dir")/${app_name}"

    if [[ -d "${app_path}" ]]; then
        alenaal_warning "App '${app_name}' already exists at: ${app_path}"
        return 1
    fi

    mkdir -p "${app_path}" "${app_path}/migrations"

    touch "${app_path}/__init__.py"
    touch "${app_path}/migrations/__init__.py"

    # Generate standard Django app files
    _generate_admin_py "${app_name}" "${root_dir}" "${apps_dir}" \
        && _generate_apps_py "${app_name}" "${root_dir}" "${apps_dir}" \
        && _generate_models_py "${app_name}" "${root_dir}" "${apps_dir}" \
        && _generate_tests_py "${app_name}" "${root_dir}" "${apps_dir}" \
        && _generate_urls_py "${app_name}" "${root_dir}" "${apps_dir}" \
        && _generate_views_py "${app_name}" "${root_dir}" "${apps_dir}"

    return $?
}

# -----------------------------------------------------------------------------
# Function: _generate_admin_py
#
# Generates admin.py for a Django app.
#
# Args:
#   $1 - app_name: Application name
#   $2 - root_dir: Root directory path
#   $3 - apps_dir: Apps directory subpath
# -----------------------------------------------------------------------------
_generate_admin_py() {
    local app_name="$1"
    local root_dir="$2"
    local apps_dir="$3"
    
    local file_path
    file_path="$(_get_file_dir "${app_name}" "${root_dir}" "${apps_dir}")/admin.py"
    local app_config_name
    app_config_name="$(_get_app_config_name "${app_name}" "${apps_dir}")"
    local capitalized_name
    capitalized_name="$(_to_capitalize "${app_name}")"
    
    cat > "$file_path" <<EOF
"""Admin Interface Configuration for ${capitalized_name} App.

This module configures the Django admin interface for models in the 
${capitalized_name} application. It defines how models are displayed, 
filtered, and edited in the admin dashboard.

The admin configuration follows Django best practices:
    - Uses @admin.register() decorator for clean registration
    - Customizes list displays for optimal data overview
    - Implements search and filter capabilities
    - Maintains separation between admin UI and business logic

Note:
    - Uncomment model imports when models are defined
    - Register each model with appropriate ModelAdmin class
    - Keep admin customizations focused on presentation only
"""

from django.contrib import admin

from ${app_config_name} import models
EOF
}

# -----------------------------------------------------------------------------
# Function: _generate_apps_py
#
# Generates apps.py for a Django app.
#
# Args:
#   $1 - app_name: Application name
#   $2 - root_dir: Root directory path
#   $3 - apps_dir: Apps directory subpath
# -----------------------------------------------------------------------------
_generate_apps_py() {
    local app_name="$1"
    local root_dir="$2"
    local apps_dir="$3"

    local file_path
    file_path="$(_get_file_dir "${app_name}" "${root_dir}" "${apps_dir}")/apps.py"
    local app_config_name
    app_config_name="$(_get_app_config_name "${app_name}" "${apps_dir}")"
    local capitalized_name
    capitalized_name="$(_to_capitalize "${app_name}")"

    cat > "$file_path" <<EOF
"""Application Configuration for ${capitalized_name} App.

This module defines the AppConfig class that registers this Django app
with the project. It controls how Django discovers, initializes, and
references the application throughout the project lifecycle.

The configuration handles critical app metadata:
    - Python import path for the app (name attribute)
    - Human-readable display name (verbose_name)
    - Default primary key field type
    - App initialization logic (ready() method)

Attributes:
    default_auto_field: Default primary key type for models
    name: Python import path (auto-configured for your structure)
    verbose_name: Human-readable app name for admin display

Note:
    - The 'name' attribute is automatically set to '${app_config_name}'
    - Override ready() method for signal registration
    - Keep configuration minimal unless app initialization is needed
"""

from django.apps import AppConfig


class ${capitalized_name}Config(AppConfig):
    """Django AppConfig for ${capitalized_name} application.

    This class configures how Django interacts with this app, including
    its Python path, display name, and initialization behavior.

    Attributes:
        default_auto_field: Model primary key field type (BigAutoField)
        name: Python import path (e.g., '${app_config_name}')
        verbose_name: Display name in admin interface
    """

    default_auto_field = "django.db.models.BigAutoField"
    name = "${app_config_name}"
    verbose_name = "${capitalized_name} Application"
EOF
}

# -----------------------------------------------------------------------------
# Function: _generate_models_py
#
# Generates models.py for a Django app.
#
# Args:
#   $1 - app_name: Application name
