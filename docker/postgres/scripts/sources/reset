#!/usr/bin/env bash

# Set environment variables for PostgreSQL database connection
export PGHOST=${POSTGRES_HOST}         # PostgreSQL server hostname
export PGPORT=${POSTGRES_PORT}         # PostgreSQL server port
export PGUSER=${POSTGRES_USER}         # PostgreSQL username
export PGPASSWORD=${POSTGRES_PASSWORD} # PostgreSQL password
export PGDATABASE=${POSTGRES_DB}       # Default database name

reset_db() {
    # Initialize variables
    local username=""
    local password=""
    local database_name=""

    # Parse named arguments
    while getopts "u:p:d:" opt; do
        case ${opt} in
        u) username=${OPTARG} ;;      # Database username
        p) password=${OPTARG} ;;      # Database password
        d) database_name=${OPTARG} ;; # Target database name
        *)
            message_error "Invalid option: ${opt}"
            exit 1
            ;;
        esac
    done

    # Validate username and password arguments
    if [[ -z $username && -z $password ]]; then
        # Use environment variables if no credentials provided
        username=$PGUSER
        password=$PGPASSWORD
    elif [[ -z $username || -z $password ]]; then
        message_error "Usage: $0 -d <database_name> -u <username> -p <password>"
        exit 1
    fi

    # Security check: prevent using 'postgres' superuser
    if [[ "${username}" == "postgres" ]]; then
        message_error "Restoring as 'postgres' user is not allowed for security reasons. Please set 'POSTGRES_USER' environment variable to a different user and try again."
        exit 1
    fi

    # Validate database name
    if [[ -z $database_name ]]; then
        message_error "Database name not provided."
        exit 1
    fi

    # Check if the database exists
    if psql -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = '$database_name'" | grep -q 1; then
        message_success "Database $database_name found. Initiating backup process..."
    else
        message_error "Database $database_name not found."
        exit 1
    fi

    # Display reset summary and get confirmation
    message_info "DATABASE RESET SUMMARY"
    message_info "   Database: ${database_name}"
    message_info "   User: ${username}"
    message_info "   Host: ${PGHOST}:${PGPORT}"

    confirm_action \
        "You are about to COMPLETELY ERASE and recreate the database '${database_name}'." \
        "DROP DATABASE ${database_name} → CREATE DATABASE ${database_name} OWNER ${username}"

    # Drop existing database
    message_info "Step 1 of 2: Dropping database '${database_name}'..."

    dropdb "${database_name}" 2>/dev/null &
    spinner "Dropping database..."

    # Verify drop operation success
    if [[ $? -eq 0 ]]; then
        message_success "Database '${database_name}' dropped successfully."
    else
        message_error "Failed to drop database '${database_name}'. The database may not exist or you may lack required permissions."
        exit 1
    fi

    # Create new database with specified owner
    message_info "Step 2 of 2: Creating database '${database_name}'..."

    createdb --owner="${username}" "${database_name}" 2>/dev/null &
    spinner "Creating database..."

    # Verify create operation success
    if [[ $? -eq 0 ]]; then
        message_success "Database reset completed successfully!"
        message_info "  Database: ${database_name}"
        message_info "  Owner: ${username}"
        message_info "  Status: Ready for use"
    else
        message_error "Failed to create database '${database_name}'. The database may already exist or you may lack required permissions."
        exit 1
    fi
}

# Validate script arguments
if [[ $# -eq 0 ]]; then
    message_error "Usage: $0 <function_name> [arguments]"
    message_newline
    message_info "Available functions:"
    message_info "  db    - Reset specific database using command-line arguments"
    message_info "  data  - Interactive database selection and reset"
    exit 1
fi

function_name=$1

# Execute requested function with provided arguments
case $function_name in
"db")
    shift
    # Reset specific database with command-line arguments
    reset_db "$@"
    ;;
"data")
    message_welcome "DATABASE RESET TOOL"
    message_info "This tool will guide you through resetting a PostgreSQL database."
    message_newline

    message_ask "Available databases on ${PGHOST}:${PGPORT}:"
    list_databases "${POSTGRES_USER}" "${POSTGRES_PASSWORD}"
    message_newline

    read -p "Enter the name of the database you wish to reset: " db_name

    if [[ -z "$db_name" ]]; then
        message_error "No database name provided. Operation cancelled."
        exit 1
    fi

    reset_db -d "${db_name}" "$@"
    ;;
*)
    message_error "Invalid function name: '${function_name}'"
    message_newline
    message_info "Available functions:"
    message_info "  db    - Reset specific database using command-line arguments"
    message_info "  data  - Interactive database selection and reset"
    exit 1
    ;;
esac
