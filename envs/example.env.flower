####################################################
#   Environment settings for the Flower service    #
####################################################

# FLOWER_USER
# Basic-auth username for the Flower web UI.
# Flower exposes a monitoring dashboard for Celery workers and tasks;
# without authentication, anyone who can reach port 5555 could inspect
# or revoke tasks. Always set a non-default value in production, and
# prefer sourcing it from a secret manager rather than committing it.
FLOWER_USER=admin

# FLOWER_PASSWORD
# Basic-auth password for the Flower web UI.
# Must be paired with FLOWER_USER. Use a strong, randomly generated
# value in production (e.g. `openssl rand -base64 32`). The default
# `admin` value is intended for local development only.
FLOWER_PASSWORD=admin
