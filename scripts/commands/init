    alenaal_newline

    # -------------------------------------------------------------------------
    # Exit Codes Section
    # -------------------------------------------------------------------------
    alenaal_format "Exit Codes:" --section --info
    alenaal_format "0   - Environment files initialized successfully" --item --list
    alenaal_format "1   - Invalid arguments" --item --list
    alenaal_format "2   - Initialization failed (copy error, missing directory, etc.)" --item --list
    alenaal_newline
}


# =============================================================================
# COMMAND FUNCTIONS
# =============================================================================

# -----------------------------------------------------------------------------
# Function: _copy_env_files
#
# Copies example environment files to actual environment files.
#
# Description:
#   Finds all files matching the pattern (default: "example.env.*") in the
#   specified directory and copies them to files with the "example." prefix
#   removed. For example, "example.env.db" is copied to ".env.db".
#
# Args:
#   $1 - directory: Directory containing environment files (absolute path)
#
# Returns:
#   0 - All files copied successfully (or skipped)
#   1 - Directory does not exist or copy failed
# -----------------------------------------------------------------------------
_copy_env_files() {
    local directory="$1"

    # Validate directory exists
    if [[ ! -d "$directory" ]]; then
        alenaal_error "Environment directory not found: $directory"
        alenaal_suggestion "Create the directory and add example.env.* files first"
        return 1
    fi

    local dir=""
    local file_name=""
    local new_file=""
    local new_file_name=""
    local copied_count=0
    local skipped_count=0
    local failed_count=0
    local found_any=0

    # Iterate through all matching example environment files
    shopt -s nullglob
    for file in "$directory"/$ENV_PATTERN; do
        found_any=1

        if [[ ! -f "$file" ]]; then
            continue
        fi

        dir=$(dirname "$file")
        file_name=$(basename "$file")

        # Remove "example." prefix to get target filename
        new_file_name="${file_name#example}"
        new_file="${dir}/${new_file_name}"

        # Skip if target already exists (unless --force)
        if [[ -f "$new_file" && "${ENV_FORCE}" != "1" ]]; then
            alenaal_note "Environment file already exists, skipping: ${new_file}"
            skipped_count=$((skipped_count + 1))
            continue
        fi

        # Copy the file
        if cp "$file" "$new_file"; then
            alenaal_success "Created: ${new_file}"
            copied_count=$((copied_count + 1))
        else
            alenaal_error "Failed to copy: ${file}"
            failed_count=$((failed_count + 1))
        fi
    done
    shopt -u nullglob

    # -------------------------------------------------------------------------
    # Summary
    # -------------------------------------------------------------------------
    alenaal_newline
    if [[ $found_any -eq 0 ]]; then
        alenaal_warning "No example environment files found in ${directory}"
        alenaal_suggestion "Expected files matching pattern: ${ENV_PATTERN}"
        return 0
    fi

    alenaal_format "Summary: ${copied_count} created, ${skipped_count} skipped, ${failed_count} failed" --item

    if [[ $failed_count -gt 0 ]]; then
        return 1
    fi

    return 0
}


# =============================================================================
# METADATA HANDLER LOADING
# =============================================================================
# When sourced by yarsin, load metadata handling functions.
# -----------------------------------------------------------------------------
source "${YARSIN_CORE_PATH}/includes/metadata" "$@"