#!/usr/bin/env bash

# =============================================================================
# Command: createapp
# Description: Create new Django applications with proper configuration
#
# Author: Mohammad Ali Amini
# Date: 2026
# =============================================================================

# -----------------------------------------------------------------------------
# COMMAND METADATA
# -----------------------------------------------------------------------------
# This metadata is used by yarsin for command discovery and help display.
# Each field provides information about the command's purpose and usage.
# -----------------------------------------------------------------------------
declare -rA CMD_METADATA=(
    [name]="createapp"
    [category]="django"
    [description]="Create new Django applications with proper configuration"
    [usage]="yarsin createapp <app_name> [app_name2 ...] [OPTIONS]"
    [version]="1.0.0"
    [requires]="python django-admin"
)


# =============================================================================
# EXECUTION GUARD
# =============================================================================
# Prevents direct execution of the command script. Ensures the command is only
# executed through the yarsin dispatcher, which provides the necessary
# environment and library loading.
#
# This guard checks two conditions:
#   1. Script is not being executed directly (sourced by yarsin)
#   2. Script is running within yarsin context (__YARSIN__ flag is set)
#
# Returns:
#   Non-zero exit code with error message if executed directly
# -----------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This command cannot be executed directly." >&2
    exit 1
elif [[ "${__YARSIN__}" != true ]]; then
    echo "Error: This command must be executed through yarsin dispatcher" >&2
    echo "Please use 'yarsin $(basename "${BASH_SOURCE[0]}") [OPTIONS]' instead." >&2
    exit 1
fi


# =============================================================================
# CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Strict Mode Configuration
# -----------------------------------------------------------------------------
# Enforces strict error handling to prevent silent failures and ensure
# predictable script behavior.
# -----------------------------------------------------------------------------
set -o errexit  # Exit immediately if any command fails
set -o pipefail # Propagate errors in pipelines
set -o nounset  # Treat unset variables as errors


# -----------------------------------------------------------------------------
# App Directory Configuration
# -----------------------------------------------------------------------------
# Maps app types to their default directory names.
# These can be overridden via environment variables.
# -----------------------------------------------------------------------------
declare -rA APP_DIRECTORIES=(
    [default]="${APP_DIRECTORY:-apps}"
    [package]="${PACK_DIRECTORY:-djansin}"
    [extras]="${EXTRAS_DIRECTORY:-extras}"
)


# =============================================================================
# MAIN FUNCTION
#
# Main execution flow for the startapp command.
#
# Description:
#   Creates one or more Django applications with a comprehensive file structure:
#   - Standard Django app files (admin.py, apps.py, models.py, etc.)
#   - Proper migrations directory with __init__.py
#   - Auto-configured AppConfig with correct Python import path
#   - Scaffolded boilerplate with helpful comments
#
# Arguments:
#   app_names - One or more application names to create
#
# Options:
#   -n, --name NAME     Application name (can be used multiple times)
#   -d, --dir DIRECTORY Target directory for apps (default: ./apps/)
#   -e, --extras        Create app in extra contributed apps directory
#   -p, --package       Create app in package directory
#   -h, --help          Display this help message
#
# Environment Variables:
#   WORK_DIRECTORY      Base project directory (default: current directory)
#   APP_DIRECTORY       Directory name for Django apps (default: 'apps')
#   PACK_DIRECTORY      Directory name for package apps (default: 'djansin')
#   EXTRAS_DIRECTORY    Directory name for extra contributed apps (default: 'extras')
#
# Returns:
#   0 - All applications created successfully
#   1 - Invalid options or missing arguments
#   2 - Some applications failed to create
# -----------------------------------------------------------------------------
main() {
    local app_names=()
    local app_dir=""
    local app_type="default"

    # -------------------------------------------------------------------------
    # Parse Command Line Arguments
    # -------------------------------------------------------------------------
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;

            -d|--dir)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--dir' requires a directory argument"
                    return 1
                fi
                app_dir="$(_normalize_path "$2")"
                shift 2
                ;;

            -n|--name)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--name' requires an argument"
                    return 1
                fi
                app_names+=("$2")
                shift 2
                ;;

            -e|--extras)
                app_type="extras"
                shift
                ;;

            -p|--package)
                app_type="package"
                shift
                ;;

            --)
                shift
                while [[ $# -gt 0 ]]; do
                    app_names+=("$1")
                    shift
                done
                break
                ;;

            -*)
                alenaal_error "Unknown option: '$1'"
                alenaal_suggestion "Use 'yarsin createapp --help' for usage information"
                return 1
                ;;

            *)
                app_names+=("$1")
                shift
                ;;
        esac
    done

    # -------------------------------------------------------------------------
    # Validate Inputs
    # -------------------------------------------------------------------------
    if [[ ${#app_names[@]} -eq 0 ]]; then
        alenaal_error "No application names provided."
        alenaal_suggestion "Usage: yarsin createapp <app_name> [app_name2 ...]"
        alenaal_suggestion "Use 'yarsin createapp --help' for more information"
        return 1
    fi

    # Set default app directory if not specified
    if [[ -z "${app_dir}" ]]; then
        app_dir="$(_get_app_dir "${app_type}")"
    fi

    # Ensure WORK_DIRECTORY is set
    local work_dir="${WORK_DIRECTORY:-$(pwd)}"

    # -------------------------------------------------------------------------
    # Create Applications
    # -------------------------------------------------------------------------
    local success_count=0
    local fail_count=0

    alenaal_newline
    for app_name in "${app_names[@]}"; do
        local normalized_name
        local app_path
        normalized_name="$(_to_lower "${app_name}")"
        app_path="$(_append_path "$work_dir" "$app_dir")/${app_name}"

        alenaal_info "Creating application: ${normalized_name}"

        if _create_single_app "${normalized_name}" "${work_dir}" "${app_dir}"; then
            alenaal_success "App '${normalized_name}' created successfully at ./${app_dir}/${normalized_name}"
            success_count=$((success_count + 1))
        else
            alenaal_warning "Failed to create app '${normalized_name}'"
            fail_count=$((fail_count + 1))
        fi
    done

    # -------------------------------------------------------------------------
    # Display Summary
    # -------------------------------------------------------------------------
    alenaal_newline
    if [[ ${fail_count} -eq 0 ]]; then
        alenaal_complete "Successfully created ${success_count} application(s)." --bold
    else
        alenaal_warning "Created ${success_count} application(s), failed: ${fail_count}"
        return 2
    fi
    alenaal_newline

    return 0
}


