# -----------------------------------------------------------------------------
# Function: _restore_dbms
#
# Performs full PostgreSQL data directory restore.
#
# Extracts a compressed tar archive to the PostgreSQL data directory.
# WARNING: This replaces ALL PostgreSQL data.
#
# Args:
#   $@ - Options: -u|--username, -p|--password, -n|--name
#
# Returns:
#   0 - Restore successful
#   1 - Invalid arguments
#   2 - Restore failed
# -----------------------------------------------------------------------------
_restore_dbms() {
    # Initialize variables
    local username=""
    local password=""
    local backup_name=""

    # Parse named arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;

            -u|--username)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--username' requires an argument"
                    return 1
                fi
                username="$2"
                shift 2
                ;;

            -p|--password)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--password' requires an argument"
                    return 1
                fi
                password="$2"
                shift 2
                ;;

            -n|--name)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--name' requires an argument"
                    return 1
                fi
                backup_name="$2"
                shift 2
                ;;

            *)
                alenaal_error "Unknown option: $1"
                return 1
                ;;
        esac
    done

    # Display welcome message with warning
    alenaal_welcome "INITIATING DBMS RESTORE PROCESS"
    alenaal_newline

    # Check if required arguments are provided
    if [[ -n "$username" && -n "$password" ]]; then
        export PGUSER="${username}"     # Set the username for PostgreSQL
        export PGPASSWORD="${password}" # Set the password for PostgreSQL
    elif [[ -n "$username" || -n "$password" ]]; then
        alenaal_error "Both username and password must be provided together"
        return 1
    fi

    # Check if backup directory exists
    if [[ ! -d "${DBMS_BACKUP_PATH}" ]]; then
        alenaal_error "DBMS backup directory not found: ${DBMS_BACKUP_PATH}"
        return 2
    fi

    # Check if required arguments are provided
    if [[ -z "$backup_name" ]]; then
        alenaal_format "Please select a DBMS backup from the available options below:" --indent 2 --step
        _list_backups "${DBMS_BACKUP_PATH}" "*_${DBMS_BACKUP_FILE_SUFFIX}.tar.gz"
        alenaal_ask "Enter the name of the DBMS backup you wish to restore: " --indent 3
        read -r backup_name

        if [[ -z "$backup_name" ]]; then
            alenaal_error "No backup name provided"
            return 1
        fi
    fi

    alenaal_alarm "This will COMPLETELY REPLACE all PostgreSQL data!" --indent 4
    alenaal_alarm "Make sure PostgreSQL service is stopped before continuing." --indent 4
    alenaal_alarm "Are you sure you want to continue? (yes/no): " --indent 4 --inline
    read -r confirmation

    if [[ "$confirmation" != "yes" ]]; then
        alenaal_cancel "Restore cancelled by user"
        return 0
    fi

    alenaal_newline

    # Construct the full path of the backup file
    local backup_path="${DBMS_BACKUP_PATH}/${backup_name}"

    # Check if the backup file exists
    if [[ ! -f "${backup_path}" ]]; then
        alenaal_error "Backup file '${backup_name}' not found in ${DBMS_BACKUP_PATH}"
        _list_backups "${DBMS_BACKUP_PATH}" "*_${DBMS_BACKUP_FILE_SUFFIX}.tar.gz"
        return 2
    fi

    # Check if the backup file has a *.tar.gz extension
    if [[ ! "$backup_path" =~ \.tar\.gz$ ]]; then
        alenaal_error "Invalid backup file format. Please provide a '*.tar.gz' file."
        return 1
    fi

    # Start the restore process
    alenaal_success "Backup found. Initiating restoration from '${backup_path}'..." --indent 2

    # Check if PostgreSQL data directory exists
    if [[ ! -d "${POSTGRESQL_DATA}" ]]; then
        alenaal_not "PostgreSQL data directory not found: ${POSTGRESQL_DATA}" --indent 2
        alenaal_ask "Create directory? (yes/no): " --indent 3
        read -r create_dir

        if [[ "$create_dir" == "yes" ]]; then
            mkdir -p "${POSTGRESQL_DATA}" || {
                alenaal_error "Failed to create directory: ${POSTGRESQL_DATA}"
                return 2
            }
        else
            alenaal_error "Restore cancelled"
            return 2
        fi
    fi

    # Remove existing data in the PostgreSQL data directory
    alenaal_info "Removing existing data in ${POSTGRESQL_DATA}..." --indent 2
    if ! rm -rf "${POSTGRESQL_DATA}"/* 2>/dev/null; then
        alenaal_error "Failed to remove existing data. Check permissions."
        return 2
    fi
    alenaal_success "Existing data removed." --indent 2

    # Extract the backup file to the data directory
    alenaal_info "Extracting backup to ${POSTGRESQL_DATA}..." --indent 2
    if ! tar -xzf "$backup_path" -C / 2>/dev/null; then
        alenaal_error "Failed to extract backup file"
        return 2
    fi
    alenaal_success "Backup extraction successful." --indent 2

    alenaal_newline
    alenaal_complete "DBMS restore completed successfully"
    alenaal_format "Restored from: ${backup_path}" --indent 2 --color blue
    alenaal_format "Restored to: ${POSTGRESQL_DATA}" --indent 2 --color blue
    alenaal_newline
    alenaal_note "Remember to start PostgreSQL service" --bold
    alenaal_newline

    return 0
}

# -----------------------------------------------------------------------------
# Function: _restore_data
#
# Performs individual database restore using psql.
#
# Drops the target database, recreates it, and applies the backup.
#
# Args:
#   $@ - Options: -d|--dbname, -b|--backup, -u|--username, -p|--password
#
# Returns:
#   0 - Restore successful
#   1 - Invalid arguments or missing credentials
#   2 - Restore failed
# -----------------------------------------------------------------------------
_restore_data() {
    # Initialize variables
    local username=""
    local password=""
    local db_name=""
    local backup_name=""

    # Parse named arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;

            -d|--dbname)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--dbname' requires an argument"
                    return 1
                fi
                db_name="$2"
                shift 2
                ;;

            -b|--backup)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--backup' requires an argument"
                    return 1
                fi
                backup_name="$2"
                shift 2
                ;;

            -u|--username)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--username' requires an argument"
                    return 1
                fi
                username="$2"
                shift 2
                ;;
            
            -p|--password)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--password' requires an argument"
                    return 1
                fi
                password="$2"
                shift 2
                ;;

            *)
                alenaal_error "Unknown option: $1"
                return 1
                ;;
        esac
    done

    # Display welcome message with warning
    alenaal_welcome "INITIATING DATABASE RESTORE PROCESS"
    alenaal_newline

    # Check if required arguments are provided
    if [[ -n "$username" && -n "$password" ]]; then
        export PGUSER="${username}"     # Set the username for PostgreSQL
        export PGPASSWORD="${password}" # Set the password for PostgreSQL
    elif [[ -n "$username" || -n "$password" ]]; then
        alenaal_error "Both username and password must be provided together"
        return 1
    fi

    # Check if backup directory exists
    if [[ ! -d "${DATA_BACKUP_PATH}" ]]; then
        alenaal_error "Data backup directory not found: ${DATA_BACKUP_PATH}"
        return 2
    fi

    # Check if the backup_name argument is provided
    if [[ -z "$backup_name" ]]; then
        alenaal_format "Please choose a backup from the available options below:" --step --indent 2
        _list_backups "${DATA_BACKUP_PATH}" "*_${DATA_BACKUP_FILE_SUFFIX}.sql.gz"
        alenaal_ask "Enter the name of the backup you wish to restore: " --indent 3 --inline
        read -r backup_name
        if [[ -z "$backup_name" ]]; then
            alenaal_error "No backup name provided"
            return 1
        fi
    fi

    # Check if the PGUSER is 'postgres' and display a warning
    if [[ "${PGUSER}" == "postgres" ]]; then
        alenaal_warning "Restoring as 'postgres' superuser is not recommended"
        alenaal_suggestion "Create a dedicated restore user with appropriate permissions"
    fi

    # Construct the full path of the backup file
    local backup_path="${DATA_BACKUP_PATH}/${backup_name}"

    # Check if the backup file exists
    if [[ ! -f "$backup_path" ]]; then
        alenaal_error "Backup file '${backup_name}' not found in ${DATA_BACKUP_PATH}"
        _list_backups "${DATA_BACKUP_PATH}" "*_${DATA_BACKUP_FILE_SUFFIX}.sql.gz"
        return 2
    fi

    # Try to extract database name from backup filename
    if [[ -z "$db_name" && "$backup_name" =~ $DATA_BACKUP_PATTERN ]]; then
        db_name="${BASH_REMATCH[1]}"
        alenaal_format "Extracted database name '${db_name}' from backup filename." --indent 4 --icon "🦘"
        alenaal_ask "Use it? (yes/no): " --indent 5
        read -r answer
        if [[ "$answer" != "yes" ]]; then
            db_name=""
        fi
    fi

    # If still no database name, prompt user
    if [[ -z "$db_name" ]]; then
        alenaal_newline
        alenaal_format "Please select a target database. Here are your current databases:" --step --indent 2
        list_databases
        alenaal_ask "Enter the name of the database to restore to: " --indent 3 --inline
        read -r db_name

        if [[ -z "$db_name" ]]; then
            alenaal_error "No database name provided"
            return 1
        fi
    fi

    # Confirm with user
    alenaal_alarm "This will DROP and RECREATE the target database!" --indent 4
    alenaal_alarm "All existing data will be lost." --indent 4
    alenaal_alarm "Restore '${backup_name}' to database '${db_name}'? (yes/no): " --indent 4 --inline --bold
    read -r confirmation
    alenaal_newline

    if [[ "$confirmation" != "yes" ]]; then
        alenaal_cancel "Restore cancelled by user" --bold
        return 0
    fi

    # Check if the database exists
    if ! _database_exists "${db_name}"; then
        alenaal_note "Database '${db_name}' does not exist. It will be created." --indent 2 --bold
    else
        alenaal_note "Database '${db_name}' exists and will be DROPPED and RECREATED!" --indent 2 --bold
    fi

    # Start the restore process
    alenaal_success "Starting restoration from '${backup_path}' to '${db_name}'." --indent 2

    # Drop the existing database if it exists
    if _database_exists "${db_name}"; then
        alenaal_info "Dropping existing database '${db_name}'..." --indent 2
        if ! dropdb "${db_name}" 2>/dev/null; then
            alenaal_error "Failed to drop database '${db_name}'. Check permissions."
            return 2
        fi
        alenaal_success "Database dropped." --indent 2
    fi

    # Create a new database with the specified owner
    alenaal_info "Creating database '${db_name}'..." --indent 2
    if ! createdb --owner="${PGUSER}" "${db_name}" 2>/dev/null; then
        alenaal_error "Failed to create database '${db_name}'"
        return 2
    fi
    alenaal_success "Database created successfully." --indent 2

    # Apply the backup to the new database
    alenaal_info "Applying backup to database '${db_name}'..." --indent 2
    if ! gunzip -c "${backup_path}" | psql "${db_name}" &>/dev/null; then
        alenaal_error "Failed to apply backup to database '${db_name}'"
        return 2
    fi
    alenaal_success "Backup applied successfully." --indent 2

    # Print a success message after the database is restored
    alenaal_newline
    alenaal_complete "Database '${db_name}' has been successfully restored from '${backup_name}'." --bold
    alenaal_format "Backup location: ${backup_path}" --indent 2 --color blue
    alenaal_format "Database: ${db_name}" --indent 2 --color blue
    alenaal_newline

    return 0
}

# -----------------------------------------------------------------------------
# Function: _list_backups
#
# Lists available backup files in a directory matching a pattern.
#
# Args:
#   $1 - directory: Directory to list backups from
#   $2 - pattern: File pattern to match
# -----------------------------------------------------------------------------
_list_backups() {
    local directory="$1"
    local pattern="$2"

    alenaal_newline
    alenaal_format "Available Backups:" --color cyan --indent 3 --bold --icon "🗜️ "

    if [[ ! -d "$directory" ]]; then
        alenaal_warning "Directory not found: $directory"
        return 1
    fi

    # Find and display matching files
    local backups=()
    while IFS= read -r file; do
        if [[ -f "$file" ]]; then
            backups+=("$(basename "$file")")
        fi
    done < <(find "$directory" -maxdepth 1 -type f -name "$pattern" 2>/dev/null | sort -r)

    if [[ ${#backups[@]} -eq 0 ]]; then
        alenaal_warning "No backups found matching pattern: $pattern"
        return 1
    fi

    # Display each backup with index
    local i=1
    for backup in "${backups[@]}"; do
        local size
        size=$(du -h "${directory}/${backup}" | cut -f1)
        alenaal_format "${i}. ${backup} (${size})" --item --indent 4
        ((i++))
    done

    alenaal_newline
}

# -----------------------------------------------------------------------------
# Function: _database_exists
#
# Checks if a database exists.
#
# Args:
#   $1 - db_name: Database name to check
#
# Returns:
#   0 if database exists, 1 otherwise
# -----------------------------------------------------------------------------
_database_exists() {
    local db_name="$1"

    if [[ -z "$db_name" ]]; then
        return 1
    fi

    psql -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = '$db_name'" | grep -q 1
    return $?
}


# =============================================================================
# METADATA HANDLER LOADING
# =============================================================================
# When sourced by yarsin, load metadata handling functions.
# This provides yarsin with access to metadata functions without
# executing the main command logic. The handler provides:
#   - metadata() - Returns all command metadata as key-value pairs
#   - metadata_value() - Returns specific metadata field value
#
# The "$@" passes any arguments through to the handler, though typically
# none are needed for metadata operations.
# -----------------------------------------------------------------------------
source "${YARSIN_CORE_PATH}/includes/metadata" "$@"
