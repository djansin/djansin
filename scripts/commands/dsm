#!/usr/bin/env bash

# =============================================================================
# Command: dsm (Docker Service Manager)
# Description: Docker Compose service management with intelligent container routing
#
# Author: Mohammad Ali Amini
# Date: 2026
# =============================================================================

# -----------------------------------------------------------------------------
# COMMAND METADATA
# -----------------------------------------------------------------------------
# This metadata is used by yarsin for command discovery and help display.
# Each field provides information about the command's purpose and usage.
# -----------------------------------------------------------------------------
declare -rA CMD_METADATA=(
    [name]="dsm"
    [category]="docker"
    [description]="Docker Service Manager - Intelligently route commands to appropriate containers"
    [usage]="yarsin dsm <command> [OPTIONS] [SERVICES...]"
    [version]="1.0.0"
    [requires]="docker docker-compose"
)


# =============================================================================
# EXECUTION GUARD
# =============================================================================
# Prevents direct execution of the command script. Ensures the command is only
# executed through the yarsin dispatcher, which provides the necessary
# environment and library loading.
#
# This guard checks two conditions:
#   1. Script is not being executed directly (sourced by yarsin)
#   2. Script is running within yarsin context (__YARSIN__ flag is set)
#
# Returns:
#   Non-zero exit code with error message if executed directly
# -----------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This command cannot be executed directly." >&2
    exit 1
elif [[ "${__YARSIN__}" != true ]]; then
    echo "Error: This command must be executed through yarsin dispatcher" >&2
    echo "Please use 'yarsin $(basename "${BASH_SOURCE[0]}") [OPTIONS]' instead." >&2
    exit 1
fi


# =============================================================================
# CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Strict Mode Configuration
# -----------------------------------------------------------------------------
# Enforces strict error handling to prevent silent failures and ensure
# predictable script behavior.
# -----------------------------------------------------------------------------
set -o errexit  # Exit immediately if any command fails
set -o pipefail # Propagate errors in pipelines
set -o nounset  # Treat unset variables as errors

# -----------------------------------------------------------------------------
# Docker Compose Configuration
# -----------------------------------------------------------------------------
# These variables define default Docker Compose behavior.
# They can be overridden by environment variables.
# -----------------------------------------------------------------------------

# Compose file path
: "${COMPOSE_FILE:=./compose.yml}"

# Database service name
: "${DB_SERVICE:=db}"

# API/Django service name
: "${API_SERVICE:=api}"

# Client/Frontend service name
: "${CLIENT_SERVICE:=client}"

# Backup directory in containers
: "${BACKUP_DIR:=/backups}"


# =============================================================================
# MAIN FUNCTION
#
# Main execution flow for the dsm command.
#
# Description:
#   Provides Docker Compose utilities with intelligent service routing:
#   - Automatically routes commands to appropriate service containers
#   - Supports database operations (backup, restore, recreate, bumng, psql)
#   - Supports API, database, and client service shortcuts
#   - Handles both running and stopped container scenarios
#   - Manages user permissions with run-as
#
# Arguments:
#   $1 - command: The command or service target to execute
#   $@ - Additional arguments passed to the underlying command
#
# Service Targets:
#   api, dja, django                        -> Route to API service
#   db, pgs, postgresql                     -> Route to Database service
#   front, vue, client                      -> Route to Client service
#   backup, restore, recreate, bumng, psql  -> Database operations
#   resetdb                                 -> Rebuild database from scratch
#   opr                                     -> Generic operation (requires service)
#   exec                                    -> Execute in running container
#   run                                     -> Run in new container
#
# Options:
#   -h, --help   Display help message
#
# Environment Variables:
#   COMPOSE_FILE      Docker Compose file path (default: ./compose.yml)
#   API_SERVICE       API service name (default: api)
#   DB_SERVICE        Database service name (default: db)
#   CLIENT_SERVICE    Client service name (default: client)
#   BACKUP_DIR        Backup directory in containers (default: /backups)
#
# Returns:
#   Exit code from the executed command
# -----------------------------------------------------------------------------
main() {
    # -------------------------------------------------------------------------
    # Parse Command Line Arguments
    # -------------------------------------------------------------------------
    if [[ $# -eq 0 ]]; then
        show_help
        return 0
    fi

    local cmd="$1"
    shift

    # Check for help flag
    if [[ "$cmd" == "--help" ]] || [[ "$cmd" == "-h" ]]; then
        show_help
        return 0
    fi

    # -------------------------------------------------------------------------
    # Command Dispatcher
    # -------------------------------------------------------------------------
    case "$cmd" in
        # Database operations (backup, restore, recreate, bumng, psql)
        backup|restore|recreate|bumng|psql)
            local command="yarsin $cmd $@"
            _handle_safe_operation "$DB_SERVICE" "$command"
            return $?
            ;;

        # Drop and recreate database.
        resetdb)
            local command="yarsin recreate \${POSTGRES_DB}"
            _handle_safe_operation "$DB_SERVICE" "$command"
            return $?
            ;;

        # API service shortcuts
        api|dja|django)
            local command="yarsin $@"
            _handle_safe_operation "$API_SERVICE" "$command"
            return $?
            ;;

        # Client/Frontend service shortcuts
        front|vue|client)
            local command="yarsin $@"
            _handle_safe_operation "$CLIENT_SERVICE" "$command"
            return $?
            ;;
        
        # Database service shortcuts
        db|pgs|postgres|postgresql)
            local command="yarsin $@"
            _handle_safe_operation "$DB_SERVICE" "$command"
            return $?
            ;;

        # Generic operation with explicit service
        opr)
            if [[ $# -lt 1 ]]; then
                alenaal_error "opr command requires a service name"
                alenaal_suggestion "Usage: yarsin dsm opr <service> <command>"
                return 1
            fi
            local service="$1"
            shift
            local command="$@"
            _handle_operation "$service" "$command"
            return $?
            ;;

        # Execute in running container
        exec)
            if [[ $# -lt 1 ]]; then
                alenaal_error "exec command requires a service name"
                alenaal_suggestion "Usage: yarsin dsm exec <service> <command>"
                return 1
            fi
            local service="$1"
            shift
            local command="$@"
            _handle_exec "$service" "$command"
            return $?
            ;;

        # Run in new container
        run)
            if [[ $# -lt 1 ]]; then
                alenaal_error "run command requires a service name"
                alenaal_suggestion "Usage: yarsin dsm run <service> <command>"
                return 1
            fi
            local service="$1"
            shift
            local command="$@"
            _handle_run "$service" "$command"
            return $?
            ;;

        # Default: try to run as API operation with yarsin command
        *)
            local command="yarsin $cmd $@"
            _handle_safe_operation "$API_SERVICE" "$command"
            return $?
            ;;
    esac
}


