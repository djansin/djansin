#!/usr/bin/env bash

# =============================================================================
# Command: init
# Description: Initialize a new project with directory structure and environment files
#
# Author: Mohammad Ali Amini
# Date: 2026
# =============================================================================

# -----------------------------------------------------------------------------
# COMMAND METADATA
# -----------------------------------------------------------------------------
# This metadata is used by yarsin for command discovery and help display.
# Each field provides information about the command's purpose and usage.
# -----------------------------------------------------------------------------
declare -rA CMD_METADATA=(
    [name]="new_project"
    [category]="project"
    [description]="Initialize a new project with directory structure and environment files"
    [usage]="yarsin new_project [OPTIONS]"
    [version]="1.0.0"
    [requires]="docker docker-compose"
)


# =============================================================================
# EXECUTION GUARD
# =============================================================================
# Prevents direct execution of the command script. Ensures the command is only
# executed through the yarsin dispatcher, which provides the necessary
# environment and library loading.
#
# This guard checks two conditions:
#   1. Script is not being executed directly (sourced by yarsin)
#   2. Script is running within yarsin context (__YARSIN__ flag is set)
#
# Returns:
#   Non-zero exit code with error message if executed directly
# -----------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This command cannot be executed directly." >&2
    exit 1
elif [[ "${__YARSIN__}" != true ]]; then
    echo "Error: This command must be executed through yarsin dispatcher" >&2
    echo "Please use 'yarsin $(basename "${BASH_SOURCE[0]}") [OPTIONS]' instead." >&2
    exit 1
fi


# =============================================================================
# CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Strict Mode Configuration
# -----------------------------------------------------------------------------
# Enforces strict error handling to prevent silent failures and ensure
# predictable script behavior.
# -----------------------------------------------------------------------------
set -o errexit  # Exit immediately if any command fails
set -o pipefail # Propagate errors in pipelines
set -o nounset  # Treat unset variables as errors

# -----------------------------------------------------------------------------
# Default Configuration
# -----------------------------------------------------------------------------
# These variables define default paths and behavior for project initialization.
# They can be overridden by environment variables.
# -----------------------------------------------------------------------------

# Compose file path for Docker Compose
: "${COMPOSE_FILE:=./compose.yml}"

# Default directories to create when initializing a project
: "${PROJECT_DIRS:=apps djansin contrib backups media static templates locale tests}"

# Environment files directory
: "${ENV_DIR:=./envs}"

# Working directory (default: current directory)
: "${WORK_DIR:=${WORKDIR:-$(pwd)}}"


# =============================================================================
# MAIN FUNCTION
# 
# Main execution flow for the new_project command.
#
# Description:
#   Initializes a new project by:
#   1. Creating common directory structures (apps, djansin, core, etc.)
#   2. Copying example environment files to actual environment files
#   3. Running the initialization inside the API container to set up
#      Django-related files (settings, URLs, etc.)
#
# Options:
#   -h, --help    Display this help message
#
# Environment Variables:
#   COMPOSE_FILE      Docker Compose file path (default: ./compose.yml)
#   PROJECT_DIRS      Directories to create (default: apps djansin core backups media static templates)
#   ENV_DIR           Environment files directory (default: ./envs)
#   WORK_DIRECTORY    Working directory (default: current directory)
#
# Returns:
#   0 - Project initialized successfully
#   1 - Invalid arguments
#   2 - Initialization failed
# -----------------------------------------------------------------------------
main() {
    # -------------------------------------------------------------------------
    # Parse Command Line Arguments
    # -------------------------------------------------------------------------
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;
            --)
                shift
                break
                ;;
            -*)
                alenaal_error "Unknown option: $1"
                alenaal_suggestion "Use 'yarsin new_project --help' for usage information"
                return 1
                ;;
            *)
                alenaal_error "Unexpected argument: $1"
                return 1
                ;;
        esac
    done

    # -------------------------------------------------------------------------
    # Step 1: Copy Environment Files
    # -------------------------------------------------------------------------
    alenaal_info "Setting up environment configuration files..."
    _copy_env_files "${WORK_DIR}/${ENV_DIR}"
    alenaal_success "Environment files configured"

    # -------------------------------------------------------------------------
    # Step 2: Create Project Directories
    # -------------------------------------------------------------------------
    alenaal_info "Creating project directory structure..."
    _create_directories $PROJECT_DIRS
    alenaal_success "Project directories created"

    # -------------------------------------------------------------------------
    # Step 3: Run Container Initialization
    # -------------------------------------------------------------------------
    alenaal_info "Running container initialization..."
    
    # Check if compose file exists
    if [[ ! -f "${COMPOSE_FILE}" ]]; then
        alenaal_warning "Docker Compose file not found: ${COMPOSE_FILE}"
        alenaal_suggestion "Skipping container initialization. Run 'yarsin init' after creating compose.yml"
    else
        # Run init inside the API container without dependencies
        if docker compose -f "${COMPOSE_FILE}" run --rm --no-deps api \
            bash -c "run-as $(id -u) -- yarsin init" 2>/dev/null; then
            alenaal_success "Container initialization completed"
        else
            alenaal_warning "Container initialization failed"
            alenaal_suggestion "You may need to build the containers first: docker compose build"
        fi
    fi

    # -------------------------------------------------------------------------
    # Completion Message
    # -------------------------------------------------------------------------
    alenaal_newline
    alenaal_success "Project initialization completed!"
    alenaal_info "Next steps:"
    alenaal_format "1. Review and update environment files in ${ENV_DIR}/" --indent 2
    alenaal_format "2. Build containers: make build" --indent 2
    alenaal_format "3. Start services: make up" --indent 2
    alenaal_newline

    return 0
}


