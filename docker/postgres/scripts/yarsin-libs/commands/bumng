#!/usr/bin/env bash

# =============================================================================
# Command: bumng (Backup Management)
# Description: PostgreSQL backup management utilities (list, delete, rename)
#
# Author: Mohammad Ali Amini
# Date: 2026
# =============================================================================

# -----------------------------------------------------------------------------
# COMMAND METADATA
# -----------------------------------------------------------------------------
# This metadata is used by yarsin for command discovery and help display.
# Each field provides information about the command's purpose and usage.
# -----------------------------------------------------------------------------
declare -rA CMD_METADATA=(
    [name]="bumng"
    [category]="database"
    [description]="PostgreSQL backup management utilities (list, delete, rename)"
    [usage]="yarsin bumng <command> [OPTIONS]"
    [version]="1.0.0"
    [requires]="postgresql-client"
)


# =============================================================================
# EXECUTION GUARD
# =============================================================================
# Prevents direct execution of the command script. Ensures the command is only
# executed through the yarsin dispatcher, which provides the necessary
# environment and library loading.
#
# This guard checks two conditions:
#   1. Script is not being executed directly (sourced by yarsin)
#   2. Script is running within yarsin context (__YARSIN__ flag is set)
#
# Returns:
#   Non-zero exit code with error message if executed directly
# -----------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This command cannot be executed directly." >&2
    exit 1
elif [[ "${__YARSIN__}" != true ]]; then
    echo "Error: This command must be executed through yarsin dispatcher" >&2
    echo "Please use 'yarsin $(basename "${BASH_SOURCE[0]}") [OPTIONS]' instead." >&2
    exit 1
fi


# =============================================================================
# CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Strict Mode Configuration
# -----------------------------------------------------------------------------
# Enforces strict error handling to prevent silent failures and ensure
# predictable script behavior.
# -----------------------------------------------------------------------------
set -o errexit  # Exit immediately if any command fails
set -o pipefail # Propagate errors in pipelines
set -o nounset  # Treat unset variables as errors


# =============================================================================
# MAIN FUNCTION
#
# Main execution flow for the bumng command.
#
# Description:
#   Provides backup management utilities for PostgreSQL backups:
#   - List backups with filtering and pagination
#   - Delete backup files
#   - Rename backup files
#
# Arguments:
#   $@ - Command and options
#
# Commands:
#   list          List backups with optional filters
#   delete        Delete a backup file
#   rename        Rename a backup file
#
# Options:
#   -h, --help    Display help message
#
# Environment Variables:
#   BACKUP_ROOT         Root backup directory (default: /backup)
#   DBMS_BACKUP_PATH    DBMS backup directory (default: ${BACKUP_ROOT}/dbms)
#   DBMS_BACKUP_GLOB    DBMS backup file pattern (default: *_dbms.tar.gz)
#   DATA_BACKUP_PATH    Data backup directory (default: ${BACKUP_ROOT}/databases)
#   DATA_BACKUP_GLOB    Data backup file pattern (default: *_data.sql.gz)
#
# Returns:
#   0 - Operation completed successfully
#   1 - Invalid arguments
#   2 - Operation failed
# -----------------------------------------------------------------------------
main() {
    # -------------------------------------------------------------------------
    # Parse Command Line Arguments
    # -------------------------------------------------------------------------
    if [[ $# -eq 0 ]]; then
        show_help
        return 0
    fi

    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;
            
            list)
                shift
                _list_backups "$@"
                return $?
                ;;

            delete)
                shift
                _delete_backup "$@"
                return $?
                ;;
            
            rename)
                shift
                _rename_backup "$@"
                return $?
                ;;

            *)
                alenaal_error "Invalid command: '$1'"
                alenaal_suggestion "Available commands: list, delete, rename"
                alenaal_suggestion "Use 'yarsin bumng --help' for usage information"
                return 1
                ;;
        esac
    done
}


