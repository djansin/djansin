# -----------------------------------------------------------------------------
# Function: _list_backups_single
#
# Displays a single backup file with formatted output.
#
# Args:
#   $1 - file: Full path to backup file
# -----------------------------------------------------------------------------
_list_backups_single() {
    local file="$1"

    if [[ ! -f "$file" ]]; then
        return 1
    fi

    local filename
    filename=$(basename "$file")

    local size
    if [[ "$(uname)" == "Darwin" ]]; then
        # macOS/BSD
        size=$(stat -f "%z" "$file" 2>/dev/null)
        size=$(numfmt --to=iec "$size" 2>/dev/null || echo "${size}B")
    else
        # Linux/GNU
        size=$(stat -c "%s" "$file" 2>/dev/null)
        size=$(numfmt --to=iec "$size" 2>/dev/null || echo "${size}B")
    fi

    local mod_date
    if [[ "$(uname)" == "Darwin" ]]; then
        mod_date=$(stat -f "%Sm" -t "%Y-%m-%d %H:%M:%S" "$file" 2>/dev/null)
    else
        mod_date=$(stat -c "%y" "$file" 2>/dev/null | cut -d'.' -f1)
    fi

    # Truncate filename if too long
    if [[ ${#filename} -gt 50 ]]; then
        filename="${filename:0:47}..."
    fi

    printf "    \033[1;36m•\033[0m \033[1;33m%-50s\033[0m  \033[1;32m[%8s]\033[0m  \033[1;34m%s\033[0m\n" \
        "$filename" "$size" "$mod_date"
}


# =============================================================================
# DELETE COMMAND FUNCTIONS
# =============================================================================
# Private helper functions for deleting backups.
# =============================================================================

# -----------------------------------------------------------------------------
# Function: _delete_backup
#
# Deletes a backup file.
#
# Args:
#   $@ - Backup name
# -----------------------------------------------------------------------------
_delete_backup() {
    local backup_name=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --help)
                show_help
                return 0
                ;;
            
            -*)
                alenaal_error "Unknown delete option: $1"
                return 1
                ;;
            
            *)
                if [[ -n "$backup_name" ]]; then
                    alenaal_error "Multiple backup names specified: '$backup_name' and '$1'"
                    return 1
                fi
                backup_name="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$backup_name" ]]; then
        alenaal_error "No backup name provided for deletion"
        alenaal_suggestion "Usage: yarsin bumng delete <backup_name>"
        return 1
    fi

    # Search for backup in both directories
    local backup_path=""
    if [[ -f "${DBMS_BACKUP_PATH}/${backup_name}" ]]; then
        backup_path="${DBMS_BACKUP_PATH}/${backup_name}"
    elif [[ -f "${DATA_BACKUP_PATH}/${backup_name}" ]]; then
        backup_path="${DATA_BACKUP_PATH}/${backup_name}"
    else
        alenaal_error "Backup not found: $backup_name"
        alenaal_suggestion "Use 'yarsin bumng list' to see available backups"
        return 2
    fi

    # Show backup details
    alenaal_newline
    alenaal_alarm "You are about to delete:" --bold
    alenaal_newline
    _list_backups_single "$backup_path"
    alenaal_newline

    # Confirm deletion
    alenaal_ask "Are you sure you want to delete this backup? (yes/no): " --indent 2
    read -r confirmation

    if [[ "$confirmation" != "yes" ]]; then
        alenaal_newline
        alenaal_cancel "Deletion cancelled" --bold
        alenaal_newline
        return 0
    fi

    # Delete the file
    if rm -f "$backup_path"; then
        alenaal_newline
        alenaal_complete "Backup deleted successfully: $backup_name" --bold
        alenaal_newline
        return 0
    else
        alenaal_error "Failed to delete backup: $backup_name"
        return 2
    fi
}


