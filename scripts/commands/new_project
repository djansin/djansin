# =============================================================================
# COMMAND FUNCTIONS
# =============================================================================
# Private helper functions for project initialization.
# These functions are prefixed with underscore to indicate internal use.
# =============================================================================

# -----------------------------------------------------------------------------
# Function: _copy_env_files
#
# Copies example environment files to actual environment files.
#
# Description:
#   Finds all files matching the pattern "example.env.*" in the specified
#   directory and copies them to files with the "example." prefix removed.
#   For example, "example.env.db" is copied to ".env.db".
#
# Args:
#   $1 - directory: Directory containing environment files (default: ./envs)
#
# Returns:
#   0 - All files copied successfully (or skipped)
#   1 - Directory does not exist
# -----------------------------------------------------------------------------
_copy_env_files() {
    local directory="$1"
    
    # Validate directory exists
    if [[ ! -d "$directory" ]]; then
        alenaal_warning "Environment directory not found: $directory"
        alenaal_suggestion "Creating directory: $directory"
        mkdir -p "$directory" || {
            alenaal_error "Failed to create directory: $directory"
            return 1
        }
    fi

    local dir=""
    local file_name=""
    local new_file=""
    local new_file_name=""
    local copied_count=0

    # Iterate through all example environment files
    for file in $directory/example.env.*; do
        if [[ -f "$file" ]]; then
            dir=$(dirname "$file")
            file_name=$(basename "$file")
            
            # Remove "example." prefix to get target filename
            new_file_name="${file_name//example/}"
            new_file="${dir}/${new_file_name}"

            # Skip if target already exists
            if [[ -f "$new_file" ]]; then
                alenaal_note "Environment file already exists, skipping: ${ENV_DIR}/${new_file_name}"
                continue
            fi
            
            # Copy the file
            if cp "$file" "$new_file"; then
                alenaal_success "Created: ${ENV_DIR}/${new_file_name}"
                copied_count=$((copied_count + 1))
            else
                alenaal_error "Failed to copy: ${ENV_DIR}/${file_name}"
                return 1
            fi
        fi
    done
    
    if [[ $copied_count -eq 0 ]]; then
        alenaal_note "No example environment files found in ${directory}"
    fi
    
    return 0
}

# -----------------------------------------------------------------------------
# Function: _create_directories
#
# Creates multiple directories if they don't already exist.
#
# Description:
#   Takes a list of directory names and creates each one in the current
#   working directory. Skips directories that already exist.
#
# Args:
#   $@ - Directory names to create (space-separated)
#
# Returns:
#   0 - All directories created successfully (or already exist)
#   1 - Failed to create one or more directories
# -----------------------------------------------------------------------------
_create_directories() {
    local directories=("$@")
    local created_count=0
    local failed_count=0
    
    # If no directories specified, use default
    if [[ ${#directories[@]} -eq 0 ]]; then
        directories=($PROJECT_DIRS)
    fi
    
    for directory in "${directories[@]}"; do
        # Remove trailing slash if present for clean output
        local dir_name="${directory%/}"
        
        if [[ -d "$dir_name" ]]; then
            alenaal_note "Directory already exists: ${dir_name}"
            continue
        fi
        
        # Create directory with parent directories if needed
        if mkdir -p "$dir_name"; then
            alenaal_success "Directory created: ${dir_name}"
            created_count=$((created_count + 1))
        else
            alenaal_error "Failed to create directory: ${dir_name}"
            ((failed_count++))
        fi
    done
    
    if [[ $failed_count -gt 0 ]]; then
        return 1
    fi
    
    return 0
}


# =============================================================================
# METADATA HANDLER LOADING
# =============================================================================
# When sourced by yarsin, load metadata handling functions.
# This provides yarsin with access to metadata functions without
# executing the main command logic. The handler provides:
#   - metadata() - Returns all command metadata as key-value pairs
#   - metadata_value() - Returns specific metadata field value
#
# The "$@" passes any arguments through to the handler, though typically
# none are needed for metadata operations.
# -----------------------------------------------------------------------------
source "${YARSIN_CORE_PATH}/includes/metadata" "$@"
