# -----------------------------------------------------------------------------
# Command Metadata
# -----------------------------------------------------------------------------
# This metadata is used by yarsin for command discovery and help display.
# Each field provides information about the command's purpose and usage.
# -----------------------------------------------------------------------------
declare -rA CMD_METADATA=(
    [name]="healthcheck"
    [category]="django"
    [description]="Health checks for Django applications in container environments"
    [usage]="yarsin healthcheck [OPTIONS]"
    [version]="1.0.0"
    [requires]="python django-admin curl"
)


# =============================================================================
# EXECUTION GUARD
# =============================================================================
# Prevents direct execution of the command script. Ensures the command is only
# executed through the yarsin dispatcher, which provides the necessary
# environment and library loading.
#
# This guard checks two conditions:
#   1. Script is not being executed directly (sourced by yarsin)
#   2. Script is running within yarsin context (__YARSIN__ flag is set)
#
# Returns:
#   Non-zero exit code with error message if executed directly
# -----------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This command cannot be executed directly." >&2
    exit 1
elif [[ "${__YARSIN__}" != true ]]; then
    echo "Error: This command must be executed through yarsin dispatcher" >&2
    echo "Please use 'yarsin $(basename "${BASH_SOURCE[0]}") [OPTIONS]' instead." >&2
    exit 1
fi


# =============================================================================
# CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Strict Mode Configuration
# -----------------------------------------------------------------------------
# Enforces strict error handling to prevent silent failures and ensure
# predictable script behavior.
# -----------------------------------------------------------------------------
set -euo pipefail

# -----------------------------------------------------------------------------
# Default Configuration Values
# -----------------------------------------------------------------------------
# These values can be overridden by environment variables. They control the
# behavior of all health checks including timeouts and connection parameters.
# -----------------------------------------------------------------------------

# Server port for the Django development server. Default is Django's default.
readonly SERVER_PORT="${SERVER_PORT:-8000}"

# Timeout in seconds for network operations. Prevents hanging checks.
readonly TIMEOUT="${HEALTHCHECK_TIMEOUT:-3}"

# Health endpoints to try in order of preference. The first responsive
# endpoint determines success for the responsiveness check.
readonly HEALTH_ENDPOINTS=(
    "/healthcheck/"  # Custom health endpoint (preferred)
    "/admin/"        # Django admin (requires auth but responds)
    "/"              # Root URL (last resort)
)


# =============================================================================
# MAIN FUNCTION
#
# Main health check dispatcher function.
#
# Description:
#   Performs comprehensive health checks for Django applications with silent,
#   machine-readable output designed for container orchestration environments
#   (Docker, Kubernetes, Nomad). Health status is communicated exclusively
#   via exit codes to support automated monitoring systems.
#
# Checks performed (configurable via command-line flags):
#   1. Server port listening status (always performed)
#   2. Server HTTP responsiveness (--responding)
#   3. Django importability and configuration (--importability)
#   4. Django system checks (--system-checks)
#   5. Database connectivity (--database)
#   6. Pending migrations (--migrations)
#
# Environment Variables:
#   SERVER_PORT: Django development server port (default: 8000)
#   HEALTHCHECK_TIMEOUT: Request timeout in seconds (default: 3)
#
# Options:
#   -r, --responding       Check server HTTP responsiveness
#   -i, --importability    Check Django importability and configuration
#   -s, --system-checks    Run Django system checks with --deploy flag
#   -d, --database         Test database connectivity for all connections
#   -m, --migrations       Check for pending database migrations
#   -h, --help             Display this help message
#
# Returns:
#   0: All requested checks passed
#   1: One or more checks failed
#
# Design Philosophy:
#   - Silent operation: No stdout during normal operation
#   - Machine-readable: Exit codes are the sole communication mechanism
#   - Progressive checks: Port check is mandatory, others optional
#   - Comprehensive: Covers network, Python, database, and schema layers
# -----------------------------------------------------------------------------
main() {
    # -------------------------------------------------------------------------
    # Flag Initialization
    # -------------------------------------------------------------------------
    # All optional checks default to false and are enabled via flags.
    # Port listening check is always performed and cannot be disabled.
    # -------------------------------------------------------------------------
    local check_responding=false
    local check_importability=false
    local check_system=false
    local check_database=false
    local check_migrations=false
    
    # -------------------------------------------------------------------------
    # Parse Command Line Arguments
    # -------------------------------------------------------------------------
    # Processes command-line flags to determine which health checks to run.
    # Each flag enables one or more optional checks beyond the mandatory
    # port listening check.
    # -------------------------------------------------------------------------
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;

            -r|--responding)
                check_responding=true
                shift
                ;;

            -i|--importability)
                check_importability=true
                shift
                ;;

            -s|--system-checks)
                check_system=true
                shift
                ;;

            -d|--database)
                check_database=true
                shift
                ;;

            -m|--migrations)
                check_migrations=true
                shift
                ;;

            *)
                alenaal_error "Unknown option: '$1'"
                alenaal_info "Use 'yarsin healthcheck --help' for usage information"
                return 1
                ;;
        esac
    done

    # -------------------------------------------------------------------------
    # Mandatory Port Listening Check
    # -------------------------------------------------------------------------
    # Always performed regardless of flags. This is the most fundamental
    # check, verifying that a process is actually listening on the port.
    # -------------------------------------------------------------------------
    if ! _check_port_listening "${SERVER_PORT}"; then
        return 1
    fi

    # -------------------------------------------------------------------------
    # Optional Health Checks
    # -------------------------------------------------------------------------
    # Execute additional checks based on user-provided flags. Each check
    # returns 0 on success, 1 on failure. Results are aggregated to produce
    # the final exit code.
    # -------------------------------------------------------------------------
    if [[ "$check_responding" == true ]]; then
        if ! _check_server_responding "${SERVER_PORT}" "${TIMEOUT}"; then
            return 1
        fi
    fi

    if [[ "$check_importability" == true ]]; then
        if ! _check_django_importability; then
            return 1
        fi
    fi

    if [[ "$check_system" == true ]]; then
        if ! _check_django_system; then
            return 1
        fi
    fi

    if [[ "$check_database" == true ]]; then
        if ! _check_database_connectivity; then
            return 1
        fi
    fi

    if [[ "$check_migrations" == true ]]; then
        if ! _check_pending_migrations; then
            return 1
        fi
    fi
}


