#!/usr/bin/env sh

# -----------------------------------------------------------------------------
# Django App Scaffold Script
# -----------------------------------------------------------------------------
# This script automates the creation of one or more Django apps inside a 
# specified apps directory. It generates the standard set of files for each 
# app (apps.py, models.py, views.py, urls.py, admin.py, tests.py), including
# proper __init__.py and migrations setup, following professional best practices.
#
# Usage:
#   ./createpp app1 app2 app3
#
# The script relies on helper functions (generate_*.py) from the _scaffold source.
# It ensures that each app is created with lowercase naming, structured 
# directories, and ready-to-use boilerplate code.
# -----------------------------------------------------------------------------

set -o errexit  # Exit immediately if any command fails
set -o pipefail # Propagate errors in pipelines
set -o nounset  # Treat unset variables as errors

# Load scaffold helper functions
source "${workdir}/sources/_scaffold"

# -----------------------------------------------------------------------------
# Function: createapp
# Description:
#   Creates multiple Django apps with standard files and structure.
# Arguments:
#   $@ : List of app names to create
# -----------------------------------------------------------------------------
createapp() {
    local app_names="$@"
    local apps_directory="${WORK_DIRECTORY}/${APPS_DIRECTORY}"

    # Check if at least one app name is provided
    if [ $# -eq 0 ]; then
        message_error "Usage: $0 <app names separated by space>. Please provide at least one app name."
        exit 1
    fi

    for name in $app_names; do
        local app_name=$(to_lower "${name}")
        local app_dir="${apps_directory}/${app_name}"

        # Create app only if it doesn't already exist
        if [ ! -d "${app_dir}" ]; then
            mkdir -p "${app_dir}" "${app_dir}/migrations"

            # Generate standard Django app files
            generate_admin_py "${app_name}" "${app_dir}/admin.py"
            generate_apps_py "${app_name}" "${app_dir}/apps.py"
            generate_models_py "${app_name}" "${app_dir}/models.py"
            generate_tests_py "${app_name}" "${app_dir}/tests.py"
            generate_urls_py "${app_name}" "${app_dir}/urls.py"
            generate_views_py "${app_name}" "${app_dir}/views.py"

            # Ensure packages are recognized
            touch "${app_dir}/__init__.py"
            touch "${app_dir}/migrations/__init__.py"

            message_success "App '${app_name}' created successfully! All standard files and directories are ready."
        else
            message_warning "The app '${app_name}' already exists. Skipping creation to avoid overwriting."
        fi
    done
}

# -----------------------------------------------------------------------------
# Entry point: call createapp with all provided arguments
# -----------------------------------------------------------------------------
createapp "$@"
