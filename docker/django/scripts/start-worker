#!/usr/bin/env bash

# =============================================================================
# Command: start-worker
# Description: Starts a Celery worker with automatic reload on code changes.
#              Uses watchmedo to monitor Python files and restart the worker
#              whenever a change is saved — useful in development only.
#
# Author: Mohammad Ali Amini
# Date: 2026
# =============================================================================

# -----------------------------------------------------------------------------
# Path Resolution
# -----------------------------------------------------------------------------
# Determines script directory and canonical project paths for consistent
# file location regardless of how the script is invoked.
# -----------------------------------------------------------------------------
WORKDIR=$(cd "$(dirname "$0")" && pwd)              # Script's directory
PROJECT_PATH=$(realpath "$WORKDIR")                 # Resolve symlinks to absolute path
YARSIN_LIB_PATH="${PROJECT_PATH}/yarsin-libs"

YARSIN_CORE_PATH="${YARSIN_LIB_PATH}/core"

# -----------------------------------------------------------------------------
# Core Library Loading
# -----------------------------------------------------------------------------
# Loads shared functionality libraries that provide common utilities,
# formatted output, and constants used throughout the dispatcher.
# -----------------------------------------------------------------------------
source "${YARSIN_CORE_PATH}/constants.sh"                  # Constants and configuration
source "${YARSIN_CORE_PATH}/alenaal.sh"                    # Formatted output functions
source "${YARSIN_CORE_PATH}/utils.sh"                      # Utility helpers


# =============================================================================
# CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Strict Mode Configuration
# -----------------------------------------------------------------------------
# Enforces strict error handling to prevent silent failures and ensure
# predictable script behavior.
# -----------------------------------------------------------------------------
set -o errexit  # Exit immediately if any command fails
set -o pipefail # Propagate errors in pipelines
set -o nounset  # Treat unset variables as errors

# -----------------------------------------------------------------------------
# Environment Variable Defaults
# -----------------------------------------------------------------------------
# Uses `: "${VAR:=default}"` to assign a default value only when the
# variable is unset or empty. This keeps `set -o nounset` from aborting
# when the caller did not export the variable explicitly.
#
# PROJECT_NAME:       Django project package (matches the Celery app name).
# CELERY_CONCURRENCY: Number of worker child processes. Two is a sane
#                     default for development; raise it in production.
# WATCH_DIR:          Directory to monitor for changes (default: project root).
# WATCH_PATTERN:      Glob pattern for files to watch (default: *.py).
# -----------------------------------------------------------------------------
: "${PROJECT_NAME:=configs}"
: "${CELERY_CONCURRENCY:=2}"
: "${WATCH_DIR:=.}"
: "${WATCH_PATTERN:=*.py}"


# =============================================================================
# MAIN FUNCTION
#
# Main execution flow for the start-worker command.
#
# Description:
#   Runs a Celery worker under `watchmedo auto-restart`, which monitors
#   Python files for changes and restarts the worker whenever a file is
#   saved. Intended for development only — the file-watching overhead and
#   immediate restart behaviour are unsuitable for production.
#
# Arguments:
#   $@ - Passed through to the worker's `celery` invocation.
#
# Environment Variables:
#   PROJECT_NAME       Django project package (default: configs)
#   CELERY_CONCURRENCY Number of worker child processes (default: 2)
#   WATCH_DIR          Directory to monitor (default: .)
#   WATCH_PATTERN      Glob pattern to watch (default: *.py)
#
# Returns:
#   0 - Worker exited cleanly
#   1 - watchmedo or celery not found, or another startup failure
# -----------------------------------------------------------------------------
main() {
    if ! command -v watchmedo >/dev/null 2>&1; then
        alenaal_error "watchmedo not found"
        alenaal_suggestion "Install it with: pip install watchdog"
        return 1
    fi

    if ! command -v celery >/dev/null 2>&1; then
        alenaal_error "celery not found"
        alenaal_suggestion "Install it with: pip install 'celery[redis]'"
        return 1
    fi

    alenaal_info "Starting Celery worker with auto-restart..."
    alenaal_info "Watching '${WATCH_DIR}' for '${WATCH_PATTERN}' changes."
    alenaal_note "Concurrency: ${CELERY_CONCURRENCY}"

    # watchmedo auto-restart
    #   -d "${WATCH_DIR}"        directory to watch
    #   -p "${WATCH_PATTERN}"    glob pattern to match
    #   -R                       recurse into subdirectories (needed for
    #                            multi-package projects like djansin.*)
    #   --                       separator: the rest is the command to run
    #
    # The command flow:
    #   1. watchmedo starts monitoring WATCH_DIR for matching file changes.
    #   2. It runs `celery -A "${PROJECT_NAME}" worker ...` once.
    #   3. On any matching change, it kills the worker and restarts it.
    #
    # Notes:
    #   - Only direct changes are detected unless `-R` is passed; `-R` is
    #     included here so edits under djansin/ and configs/ are picked up.
    #   - Uses polling by default; add `--debug-force-polling` explicitly
    #     if inotify is unavailable (e.g. some bind-mounted filesystems).
    #   - Restarts are immediate on save (no debouncing); rapid successive
    #     saves will trigger rapid restarts.
    watchmedo auto-restart \
        -d "${WATCH_DIR}" \
        -p "${WATCH_PATTERN}" \
        -R \
        -- celery -A "${PROJECT_NAME}" worker \
            --loglevel=info \
            --concurrency="${CELERY_CONCURRENCY}"
}


# =============================================================================
# SCRIPT ENTRY POINT
# =============================================================================
main "$@"
