    alenaal_format "3. Run initial migrations:" --item --list --indent 4
    alenaal_format "yarsin django-admin migrate" --indent 6 --bold

    alenaal_format "4. Start development server:" --item --list --indent 4
    alenaal_format "yarsin django-admin runserver" --indent 6 --bold
    alenaal_newline

    # -------------------------------------------------------------------------
    # Requirements Section
    # -------------------------------------------------------------------------
    alenaal_format "Requirements:" --section --warning
    alenaal_format "Python 3.13+" --item --list
    alenaal_format "Django 5.2+" --item --list
    alenaal_format "django-admin in PATH" --item --list
    alenaal_format "WORK_DIRECTORY environment variable set" --item --list
    alenaal_format "Write permissions in WORK_DIRECTORY" --item --list
    alenaal_newline

    # -------------------------------------------------------------------------
    # Exit Codes Section
    # -------------------------------------------------------------------------
    alenaal_format "Exit Codes:" --section --info
    alenaal_format "0 - Project created successfully" --item --list
    alenaal_format "1 - Invalid options or missing WORK_DIRECTORY" --item --list
    alenaal_format "2 - Project creation failed (directory exists, django-admin error)" --item --list
    alenaal_newline
}


# =============================================================================
# METADATA HANDLER LOADING
# =============================================================================
# When sourced by yarsin, load metadata handling functions.
# This provides yarsin with access to metadata functions without
# executing the main command logic. The handler provides:
#   - metadata() - Returns all command metadata as key-value pairs
#   - metadata_value() - Returns specific metadata field value
#
# The "$@" passes any arguments through to the handler, though typically
# none are needed for metadata operations.
# -----------------------------------------------------------------------------
source "${YARSIN_CORE_PATH}/includes/metadata" "$@"
