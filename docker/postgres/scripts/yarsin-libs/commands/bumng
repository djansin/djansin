# =============================================================================
# LIST COMMAND FUNCTIONS
# =============================================================================
# Private helper functions for listing backups.
# =============================================================================

# -----------------------------------------------------------------------------
# Function: _list_backups
#
# Main list dispatcher function.
#
# Parses list-specific options and calls appropriate listing function.
#
# Args:
#   $@ - List options (--dbms, --data, --all, --limit, --page, --from, --to)
# -----------------------------------------------------------------------------
_list_backups() {
    local type="all"
    local limit=5
    local page=1
    local from=""
    local to=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --help)
                show_help
                return 0
                ;;
            
            --dbms)
                type="dbms"
                shift
                ;;
            
            --data)
                type="data"
                shift
                ;;
            
            --all)
                type="all"
                shift
                ;;
            
            -l|--limit)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--limit' requires a number"
                    return 1
                fi
                if [[ ! "$2" =~ ^[0-9]+$ ]]; then
                    alenaal_error "Limit must be a positive number: $2"
                    return 1
                fi
                limit="$2"
                shift 2
                ;;
            
            -p|--page)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--page' requires a number"
                    return 1
                fi
                if [[ ! "$2" =~ ^[0-9]+$ ]] || [[ "$2" -lt 1 ]]; then
                    alenaal_error "Page must be a positive number: $2"
                    return 1
                fi
                page="$2"
                shift 2
                ;;
            
            -f|--from)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--from' requires a date (YYYY-MM-DD)"
                    return 1
                fi
                if [[ ! "$2" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
                    alenaal_error "Invalid date format. Use YYYY-MM-DD: $2"
                    return 1
                fi
                from="$2"
                shift 2
                ;;
            
            -t|--to)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--to' requires a date (YYYY-MM-DD)"
                    return 1
                fi
                if [[ ! "$2" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
                    alenaal_error "Invalid date format. Use YYYY-MM-DD: $2"
                    return 1
                fi
                to="$2"
                shift 2
                ;;
            
            *)
                alenaal_error "Unknown list option: $1"
                return 1
                ;;
        esac
    done

    # Call appropriate listing function based on type
    case "$type" in
        dbms)
            _show_dbms_backups "$limit" "$page" "$from" "$to"
            ;;
        data)
            _show_data_backups "$limit" "$page" "$from" "$to"
            ;;
        all)
            _show_all_backups "$limit" "$page" "$from" "$to"
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Function: _show_dbms_backups
#
# Shows DBMS (full PostgreSQL data directory) backups.
#
# Args:
#   $1 - limit: Number of results per page
#   $2 - page: Page number
#   $3 - from: Start date filter (YYYY-MM-DD)
#   $4 - to: End date filter (YYYY-MM-DD)
# -----------------------------------------------------------------------------
_show_dbms_backups() {
    local limit="$1"
    local page="$2"
    local from="$3"
    local to="$4"

    alenaal_newline
    alenaal_format "DBMS Backups (Full PostgreSQL Data Directory):" --subsection --bold --indent 2
    alenaal_format "Location: ${DBMS_BACKUP_PATH}" --item --italic --indent 2

    if [[ ! -d "${DBMS_BACKUP_PATH}" ]]; then
        alenaal_warning "DBMS backup directory does not exist: ${DBMS_BACKUP_PATH}" --indent 3
        return 0
    fi

    # Build find command with filters
    local find_cmd="find '${DBMS_BACKUP_PATH}' -maxdepth 1 -type f -name '${DBMS_BACKUP_GLOB}'"

    # Add date filters if specified
    if [[ -n "$from" ]]; then
        local from_timestamp
        from_timestamp=$(date -d "$from" +%s 2>/dev/null)
        if [[ -n "$from_timestamp" ]]; then
            find_cmd+=" -newermt '$from'"
        else
            alenaal_warning "Invalid from date, ignoring filter: $from"
        fi
    fi

    if [[ -n "$to" ]]; then
        local to_timestamp
        to_timestamp=$(date -d "$to 23:59:59" +%s 2>/dev/null)
        if [[ -n "$to_timestamp" ]]; then
            find_cmd+=" ! -newermt '$to 23:59:59'"
        else
            alenaal_warning "Invalid to date, ignoring filter: $to"
        fi
    fi

    # Get total count for pagination
    local total=$(eval "$find_cmd" 2>/dev/null | wc -l)
    if [[ "$total" -eq 0 ]]; then
        alenaal_warning "No DBMS backups found" --indent 3
        return 0
    fi

    # Calculate pagination
    local start=$(( (page - 1) * limit + 1 ))
    if [[ $start -gt $total ]]; then
        start=$(( total / limit * limit + 1))
        page=$(( total / limit + 1 ))

        if [[ $start -gt $total ]]; then
            page=$(( total / limit ))
            start=$(( (page - 1) * limit + 1 ))
        fi
    fi
    local end=$(( page * limit ))
    if [[ "$end" -gt "$total" ]]; then
        end="$total"
    fi

    alenaal_info "Showing $start-$end of $total backups (Page $page)" --indent 3

    # Execute find and pipe to list_backups function
    eval "$find_cmd" 2>/dev/null | sort -r | sed -n "${start},${end}p" | while read -r file; do
        _list_backups_single "$file"
    done

    # Show pagination info
    if [[ "$total" -gt "$limit" ]] && [[ $end -lt $total ]]; then
        alenaal_newline
        alenaal_note "Use '--page $((page + 1))' to see next page" --indent 2
    fi

    alenaal_newline
}

