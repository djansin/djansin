#!/usr/bin/env sh

# -----------------------------------------------------------------------------
# Django App Starter Script
# -----------------------------------------------------------------------------
# This script creates one or more Django apps inside the specified apps 
# directory using the 'django-admin startapp' command.
# After creation, it automatically updates the AppConfig.name attribute
# in apps.py to match the project structure.
#
# Usage:
#   ./startapp app1 app2 app3
#
# Features:
#   - Automatically creates standard Django app structure
#   - Updates AppConfig.name to match apps directory
#   - Provides professional success/error messages
# -----------------------------------------------------------------------------

set -o errexit  # Exit immediately if any command fails
set -o pipefail # Propagate errors in pipelines
set -o nounset  # Treat unset variables as errors

# -----------------------------------------------------------------------------
# Function: fix_appconfig_name
# Description:
#   Ensures that apps.py contains the correct AppConfig.name for each app.
# Arguments:
#   $1 : Name of the app
# -----------------------------------------------------------------------------
fix_appconfig_name() {
    local app_name="$1"
    local app_dir="${WORK_DIRECTORY}/${APPS_DIRECTORY}/${app_name}"
    local apps_py="${app_dir}/apps.py"

    # Ensure apps.py exists
    if [ ! -f "$apps_py" ]; then
        message_error "apps.py not found in ${app_dir}. Cannot update AppConfig.name."
        return 1
    fi

    # Safely replace the 'name = "<something>"' line
    sed -i \
        "s/^ *name *= *['\"][^'\"]*['\"]/    name = \"${APPS_DIRECTORY}.${app_name}\"/" \
        "$apps_py"

    message_success "Updated AppConfig.name → ${APPS_DIRECTORY}.${app_name}"
}

# -----------------------------------------------------------------------------
# Function: startapp
# Description:
#   Creates multiple Django apps using 'django-admin startapp' and updates 
#   their AppConfig.name.
# Arguments:
#   $@ : List of app names to create
# -----------------------------------------------------------------------------
startapp() {
    local app_names="$@"
    local apps_directory="${WORK_DIRECTORY}/${APPS_DIRECTORY}"

    # Check if at least one app name is provided
    if [ $# -eq 0 ]; then
        message_error "Usage: $0 <app names separated by space>. Please provide at least one app name."
        exit 1
    fi

    for app_name in $app_names; do
        mkdir -p "${apps_directory}/${app_name}" &&
            django-admin startapp "${app_name}" "${apps_directory}/${app_name}"

        if [ $? -eq 0 ]; then
            message_success "App '${app_name}' created successfully."

            # Fix AppConfig.name after creation
            fix_appconfig_name "$app_name"
        else
            message_error "Failed to create the app '${app_name}'. Please check your setup."
        fi
    done
}

# -----------------------------------------------------------------------------
# Entry point: call startapp with all provided arguments
# -----------------------------------------------------------------------------
startapp "$@"
