# ------------------------------
# Generate apps.py
# ------------------------------
generate_apps_py() {
    local app_name="$1"
    local file_path="$2"

    # Determine AppConfig.name value
    local app_config_name
    if [ -n "${APPS_DIRECTORY:-}" ]; then
        app_config_name="${APPS_DIRECTORY}.${app_name}"
    else
        app_config_name="${app_name}"
    fi

    cat > "$file_path" <<EOF
"""
App configuration for the $(to_capitalize "${app_name}") app.

Defines the AppConfig class that registers this app with Django.
This configuration controls how Django identifies and initializes the application.

Important notes:
    - The 'name' attribute must match the Python import path
    - AppConfig can be extended for advanced initialization (e.g., signals)
    - Set default_auto_field for consistent primary key behavior
"""

from django.apps import AppConfig


class $(to_capitalize "${app_name}")Config(AppConfig):
    """
    Configuration class for the $(to_capitalize "${app_name}") application.

    Provides Django with essential metadata about this app including
    its location, display name, and default settings.
    """

    default_auto_field = 'django.db.models.BigAutoField'
    name = "${app_config_name}"
    verbose_name = "$(to_capitalize "${app_name}") Application"
EOF
}

