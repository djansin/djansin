#!/usr/bin/env bash

# =============================================================================
# Command: init
# Description: Initialize a new Django project with multi-environment setup
#
# Author: Mohammad Ali Amini
# Date: 2026
# =============================================================================

# -----------------------------------------------------------------------------
# Command Metadata
# -----------------------------------------------------------------------------
# This metadata is used by yarsin for command discovery and help display.
# Each field provides information about the command's purpose and usage.
# -----------------------------------------------------------------------------
declare -rA CMD_METADATA=(
    [name]="init"
    [category]="django"
    [description]="Initialize a new Django project with multi-environment configuration"
    [usage]="yarsin init [OPTIONS] [PROJECT_NAME] [PROJECT_DIR]"
    [version]="1.0.0"
    [requires]="python django-admin"
)


# =============================================================================
# EXECUTION GUARD
# =============================================================================
# Prevents direct execution of the command script. Ensures the command is only
# executed through the yarsin dispatcher, which provides the necessary
# environment and library loading.
#
# This guard checks two conditions:
#   1. Script is not being executed directly (sourced by yarsin)
#   2. Script is running within yarsin context (__YARSIN__ flag is set)
#
# Returns:
#   Non-zero exit code with error message if executed directly
# -----------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This command cannot be executed directly." >&2
    exit 1
elif [[ "${__YARSIN__}" != true ]]; then
    echo "Error: This command must be executed through yarsin dispatcher" >&2
    echo "Please use 'yarsin $(basename "${BASH_SOURCE[0]}") [OPTIONS]' instead." >&2
    exit 1
fi


# =============================================================================
# CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Strict Mode Configuration
# -----------------------------------------------------------------------------
# Enforces strict error handling to prevent silent failures and ensure
# predictable script behavior.
# -----------------------------------------------------------------------------
set -o errexit  # Exit script immediately if a command fails
set -o pipefail # Exit script when a command in a pipeline fails


# =============================================================================
# MAIN FUNCTION
#
# Main execution flow for the init command.
#
# Description:
#   Creates a new Django project with an advanced multi-environment structure:
#   - Environment-specific settings (base.py, development.py, production.py, testing.py)
#   - Environment-specific URL configurations
#   - Proper Python package structure with __init__.py files
#   - Comprehensive documentation in generated files
#
# Arguments:
#   $1 - PROJECT_NAME: Name of the Django project (default: from env or current dir)
#   $2 - PROJECT_DIR: Directory to create project in (default: from env or current dir)
#
# Options:
#   -n, --name NAME     Project name (overrides positional argument)
#   -d, --dir DIRECTORY Project directory (overrides positional argument)
#   -h, --help          Display this help message
#
# Environment Variables:
#   PROJECT_NAME        Default project name if not specified
#   WORK_DIRECTORY      Default working directory if not specified
#
# Returns:
#   0 - Project initialized successfully
#   1 - Missing required parameters
#   2 - Project creation failed
# -----------------------------------------------------------------------------
main() {
    local project_name=""
    local project_dir=""

    # -------------------------------------------------------------------------
    # Parse Command Line Arguments
    # -------------------------------------------------------------------------
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;
            
            -n|--name)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--name' requires an argument"
                    return 1
                fi
                project_name="$2"
                shift 2
                ;;

            -d|--dir)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--dir' requires an argument"
                    return 1
                fi
                project_dir="$2"
                shift 2
                ;;

            --)
                shift
                if [[ -z "$project_name" && -n "$1" ]]; then
                    project_name="$1"
                    shift
                fi
                if [[ -z "$project_dir" && -n "$1" ]]; then
                    project_dir="$1"
                    shift
                fi
                break
                ;;

            -*)
                alenaal_error "Unknown option: '$1'"
                alenaal_suggestion "Use 'yarsin init --help' for usage information"
                return 1
                ;;

            *)
                if [[ -z "$project_name" ]]; then
                    project_name="$1"
                elif [[ -z "$project_dir" ]]; then
                    project_dir="$1"
                else
                    alenaal_error "Unexpected argument: '$1'"
                    alenaal_suggestion "Use 'yarsin init --help' for usage information" 
                    return 1
                fi
                shift
                ;;
        esac
    done

    # -------------------------------------------------------------------------
    # Set Default Values
    # -------------------------------------------------------------------------
    project_name="${project_name:-${PROJECT_NAME:-}}"
    project_dir="${project_dir:-${WORK_DIRECTORY:-$(pwd)}}"

    # -------------------------------------------------------------------------
    # Validate Inputs
    # -------------------------------------------------------------------------
    if [[ -z "$project_name" ]]; then
        alenaal_error "Project name is required. Set PROJECT_NAME or provide as argument."
        alenaal_suggestion "Use 'yarsin init --help' for usage information"
        return 1
    fi

    if [[ -z "$project_dir" ]]; then
        alenaal_error "Work directory is required. Set WORK_DIRECTORY or provide as argument."
        alenaal_suggestion "Use 'yarsin init --help' for usage information"
        return 1
    fi

    # -------------------------------------------------------------------------
    # Create Base Django Project
    # -------------------------------------------------------------------------
    alenaal_info "Initializing Django project: ${project_name} in ${project_dir}"
    if ! django-admin startproject "${project_name}" "${project_dir}" 2>/dev/null; then
        alenaal_error "Failed to create Django project: ${project_name}"
        return 2
    fi

    alenaal_success "Django project skeleton created"

    # -------------------------------------------------------------------------
    # SETTINGS CONFIGURATION
    # -------------------------------------------------------------------------

    # Create settings directory and organize configuration files
    alenaal_info "Setting up environment-based configuration structure..."

    # Create settings directory with __init__.py for Python package
    if ! mkdir -p "${project_dir}/${project_name}/settings"; then
        alenaal_error "Failed to create settings directory structure"
        return 2
    fi

    # Create __init__.py to make settings a proper Python package
    if ! touch "${project_dir}/${project_name}/settings/__init__.py"; then
        alenaal_error "Could not create __init__.py in settings directory"
        return 2
    fi

    # Move the default settings.py to base.py as our foundation
    if ! mv "${project_dir}/${project_name}/settings.py" "${project_dir}/${project_name}/settings/base.py"; then
        alenaal_error "Failed to move settings.py to base.py"
        return 2
    fi
    alenaal_success "Base settings file created: ./${project_name}/settings/base.py"

    # Generate environment-specific settings files
    alenaal_info "Creating environment-specific settings files..."

    if ! _generate_setting_file "production" "${project_name}" "${project_dir}"; then
        alenaal_error "Failed to create production settings"
        return 2
    fi
    alenaal_success "Production settings created: ./${project_name}/settings/production.py"

    if ! _generate_setting_file "development" "${project_name}" "${project_dir}"; then
        alenaal_error "Failed to create development settings"
        return 2
    fi
    alenaal_success "Development settings created: ./${project_name}/settings/development.py"

    if ! _generate_setting_file "testing" "${project_name}" "${project_dir}"; then
        alenaal_error "Failed to create testing settings"
        return 2
    fi
    alenaal_success "Testing settings created: ./${project_name}/settings/testing.py"

    # -------------------------------------------------------------------------
    # URL CONFIGURATION
    # -------------------------------------------------------------------------

    # Create URLs directory and organize routing files
    alenaal_info "Setting up environment-based URL structure..."

    # Create URLs directory with __init__.py for Python package
    if ! mkdir -p "${project_dir}/${project_name}/urls"; then       
        alenaal_error "Failed to create URLs directory structure"
        return 2
    fi

    # Create __init__.py to make urls a proper Python package
    if ! touch "${project_dir}/${project_name}/urls/__init__.py"; then
        alenaal_error "Could not create __init__.py in urls directory"
        return 2
    fi

    # Move the default urls.py to base.py as our routing foundation
    if ! mv "${project_dir}/${project_name}/urls.py" "${project_dir}/${project_name}/urls/base.py"; then
        alenaal_error "Failed to move urls.py to base.py"
        return 2
    fi
    alenaal_success "Base URL configuration created: ./${project_name}/urls/base.py"

    # Generate environment-specific URL configuration files
    alenaal_info "Creating environment-specific URL configurations..."

    if ! _generate_urls_file "production" "${project_name}" "${project_dir}"; then
        alenaal_error "Failed to create production URLs"
        return 2
    fi
    alenaal_success "Production URLs created: ./${project_name}/urls/production.py"

    if ! _generate_urls_file "development" "${project_name}" "${project_dir}"; then
        alenaal_error "Failed to create development URLs"
        return 2
    fi
    alenaal_success "Development URLs created: ./${project_name}/urls/development.py"

    if ! _generate_urls_file "testing" "${project_name}" "${project_dir}"; then
        alenaal_error "Failed to create testing URLs"
        return 2
    fi
    alenaal_success "Testing URLs created: ./${project_name}/urls/testing.py"

    # -------------------------------------------------------------------------
    # FINALIZATION
    # -------------------------------------------------------------------------
    _project_successfully_initiated_message "${project_name}" "${project_dir}"

    return 0
}


