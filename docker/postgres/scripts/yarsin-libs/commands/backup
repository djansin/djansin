# -----------------------------------------------------------------------------
# Function: _backup_dbms
#
# Performs full PostgreSQL data directory backup.
#
# Creates a compressed tar archive of the PostgreSQL data directory.
# Requires filesystem access to PGDATA.
#
# Args:
#   $@ - Options: -u|--username, -p|--password, -n|--name
#
# Returns:
#   0 - Backup successful
#   1 - Invalid arguments
#   2 - Backup failed
# -----------------------------------------------------------------------------
_backup_dbms() {
    # Initialize variables
    local username=""
    local password=""
    local backup_name=""
    local backup_path=""

    # Parse named arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;

            -u|--username)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--username' requires an argument"
                    return 1
                fi
                username="$2"
                shift 2
                ;;

            -p|--password)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--password' requires an argument"
                    return 1
                fi
                password="$2"
                shift 2
                ;;

            -n|--name)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--name' requires an argument"
                    return 1
                fi
                backup_name="$2"
                shift 2
                ;;

            *)
                alenaal_error "Unknown option: $1"
                return 1
                ;;
        esac
    done

    # Check if required arguments are provided
    if [[ -n "$username" && -n "$password" ]]; then
        export PGUSER="${username}"     # Set the username for PostgreSQL
        export PGPASSWORD="${password}" # Set the password for PostgreSQL
    elif [[ -n "$username" || -n "$password" ]]; then
        alenaal_error "Both username and password must be provided together"
        return 1
    fi

    # Ensure backup directory exists
    if ! _ensure_directory "${DBMS_BACKUP_PATH}"; then
        alenaal_error "Failed to create backup directory: ${DBMS_BACKUP_PATH}"
        return 2
    fi

    # Check if backup source exists
    if [[ ! -d "${POSTGRESQL_DATA}" ]]; then
        alenaal_error "Backup source directory not found: ${POSTGRESQL_DATA}"
        alenaal_suggestion "Set PGDATA environment variable to correct PostgreSQL data directory"
        return 2
    fi

    # Set backup path
    if [[ -n "$backup_name" ]]; then
        backup_path="${DBMS_BACKUP_PATH}/${backup_name}"
    else
        # Set default backup file name if not provided
        backup_path="${DBMS_BACKUP_PATH}/${DBMS_BACKUP_FILE_PREFIX}___$(date +'%Y_%m_%d__%H_%M_%S')___${DBMS_BACKUP_FILE_SUFFIX}.tar.gz"
    fi

    # Display welcome message
    alenaal_welcome "Initializing DBMS backup..."
    alenaal_newline
    alenaal_info "Creating DBMS backup at: ${backup_path}"

    # Create a tar archive of the PostgreSQL data directory and compress it
    if ! (tar -cf - "${POSTGRESQL_DATA}" | gzip -q -9 >"${backup_path}") 2>/dev/null; then
        alenaal_error "Backup failed during compression"
        rm -f "${backup_path}" 2>/dev/null || true
        return 2
    fi

    # Verify backup was created
    if [[ ! -f "${backup_path}" ]]; then
        alenaal_error "Backup file was not created"
        return 2
    fi

    # Display success message
    alenaal_newline
    alenaal_complete "DBMS backup successfully created" --bold
    alenaal_format "Backup location: ${backup_path}" --color blue --indent 2
    alenaal_format "Backup size: $(du -h "${backup_path}" | cut -f1)" --color blue --indent 2
    alenaal_newline

    return 0
}

# -----------------------------------------------------------------------------
# Function: _backup_data
#
# Performs individual database backup using pg_dump.
#
# Can run interactively (listing databases and prompting) or non-interactively
# with explicit database name. Creates compressed SQL dump.
#
# Args:
#   $@ - Options: -d|--dbname, -b|--backup, -u|--username, -p|--password
#
# Returns:
#   0 - Backup successful
#   1 - Invalid arguments or missing credentials
#   2 - Backup failed
# -----------------------------------------------------------------------------
_backup_data() {
    local db_name=""
    local username=""
    local password=""
    local backup_name=""
    local backup_path=""

    # Parse named arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;

            -d|--dbname)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--dbname' requires an argument"
                    return 1
                fi
                db_name="$2"
                shift 2
                ;;

            -b|--backup)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--backup' requires an argument"
                    return 1
                fi
                backup_name="$2"
                shift 2
                ;;

            -u|--username)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--username' requires an argument"
                    return 1
                fi
                username="$2"
                shift 2
                ;;
            
            -p|--password)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--password' requires an argument"
                    return 1
                fi
                password="$2"
                shift 2
                ;;

            *)
                alenaal_error "Unknown option: $1"
                return 1
                ;;
        esac
    done

    # Check if required username and password are provided
    if [[ -n "$username" && -n "$password" ]]; then
        export PGUSER="${username}"     # Set the username for accessing the PostgreSQL database
        export PGPASSWORD="${password}" # Set the password for the PostgreSQL database user
    elif [[ -n "$username" || -n "$password" ]]; then
        alenaal_error "Both username and password must be provided together"
        return 1
    fi

    # Check if the PGUSER is 'postgres' and display a warning
    if [[ "${PGUSER}" == "postgres" ]]; then
        alenaal_warning "Backing up as 'postgres' superuser is not recommended"
        alenaal_suggestion "Create a dedicated backup user with appropriate permissions"
    fi

    # Display welcome message
    alenaal_welcome "Initializing database backup"
    alenaal_newline

    # If database name not provided, list databases and prompt
    if [[ -z "$db_name" ]]; then
        alenaal_format "Please select a database to back up. Here are your current databases:" --step --indent 2
        alenaal_newline
        list_databases
        alenaal_ask "Enter the name of the database you wish to back up: " --indent 3
        read -r db_name
        if [[ -z "$db_name" ]]; then
            alenaal_error "No database name provided"
            return 1
        fi
        alenaal_newline
    fi

    # Check if the database exists
    if ! database_exists "${db_name}"; then
        alenaal_error "Database '${db_name}' not found"
        return 2
    fi

    # Ensure backup directory exists
    if ! _ensure_directory "${DATA_BACKUP_PATH}"; then
        alenaal_error "Failed to create backup directory: ${DATA_BACKUP_PATH}"
        return 2
    fi

    # Check if the backup file name is provided as an argument
    if [[ -n "$backup_name" ]]; then
        backup_path="${DATA_BACKUP_PATH}/${backup_name}.sql.gz"
    else
        # Set default backup file name if not provided
        backup_path="${DATA_BACKUP_PATH}/${db_name}___$(date +'%Y_%m_%d__%H_%M_%S')___${DATA_BACKUP_FILE_SUFFIX}.sql.gz"
    fi

    alenaal_success "Database '${db_name}' found. Initiating backup process..." --indent 2
    alenaal_newline

    # Set database name
    export PGDATABASE="${db_name}"

    # Backup the database in a compressed format
    if ! pg_dump | gzip -q -9 >"${backup_path}"; then
        alenaal_error "Backup failed during database dump"
        rm -f "${backup_path}" 2>/dev/null || true
        return 2
    fi

    # Verify backup was created
    if [[ ! -f "${backup_path}" ]]; then
        alenaal_error "Backup file was not created"
        return 2
    fi

    alenaal_complete "Backup successfully created"
    alenaal_format "Backup location: ${backup_path}" --color blue --indent 2
    alenaal_format "Backup size: $(du -h "${backup_path}" | cut -f1)" --color blue --indent 2
    alenaal_newline

    return 0
}

# -----------------------------------------------------------------------------
# Function: _ensure_directory
#
# Ensures a directory exists, creating it if necessary.
#
# Args:
#   $1 - directory: Directory path to ensure
#
# Returns:
#   0 on success, 1 on failure
# -----------------------------------------------------------------------------
_ensure_directory() {
    local directory="$1"

    if [[ -z "$directory" ]]; then
        return 1
    fi

    if [[ ! -d "$directory" ]]; then
        mkdir -p "$directory" 2>/dev/null || return 1
    fi

    return 0
}


