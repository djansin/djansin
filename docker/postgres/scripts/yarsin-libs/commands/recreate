#!/usr/bin/env bash

# =============================================================================
# Command: recreate
# Description: Drop and recreate a PostgreSQL database
#
# Author: Mohammad Ali Amini
# Date: 2026
# =============================================================================

# -----------------------------------------------------------------------------
# COMMAND METADATA
# -----------------------------------------------------------------------------
# This metadata is used by yarsin for command discovery and help display.
# Each field provides information about the command's purpose and usage.
# -----------------------------------------------------------------------------
declare -rA CMD_METADATA=(
    [name]="recreate"
    [category]="database"
    [description]="Drop and recreate a PostgreSQL database"
    [usage]="yarsin recreate [OPTIONS] [DATABASE_NAME]"
    [version]="1.0.0"
    [requires]="postgresql-client"
)


# =============================================================================
# EXECUTION GUARD
# =============================================================================
# Prevents direct execution of the command script. Ensures the command is only
# executed through the yarsin dispatcher, which provides the necessary
# environment and library loading.
#
# This guard checks two conditions:
#   1. Script is not being executed directly (sourced by yarsin)
#   2. Script is running within yarsin context (__YARSIN__ flag is set)
#
# Returns:
#   Non-zero exit code with error message if executed directly
# -----------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This command cannot be executed directly." >&2
    exit 1
elif [[ "${__YARSIN__}" != true ]]; then
    echo "Error: This command must be executed through yarsin dispatcher" >&2
    echo "Please use 'yarsin $(basename "${BASH_SOURCE[0]}") [OPTIONS]' instead." >&2
    exit 1
fi


# =============================================================================
# CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Strict Mode Configuration
# -----------------------------------------------------------------------------
# Enforces strict error handling to prevent silent failures and ensure
# predictable script behavior.
# -----------------------------------------------------------------------------
set -o errexit  # Exit immediately if any command fails
set -o pipefail # Propagate errors in pipelines
set -o nounset  # Treat unset variables as errors

# -----------------------------------------------------------------------------
# PostgreSQL Connection Configuration
# -----------------------------------------------------------------------------
# These environment variables are used by PostgreSQL client tools.
# They can be set externally or will use these defaults.
# -----------------------------------------------------------------------------

# Set environment variables for PostgreSQL database connection
export PGHOST="${POSTGRES_HOST:-localhost}"         # PostgreSQL server hostname
export PGPORT="${POSTGRES_PORT:-5432}"              # PostgreSQL server port
export PGUSER="${POSTGRES_USER:-postgres}"          # PostgreSQL username
export PGPASSWORD="${POSTGRES_PASSWORD:-}"          # PostgreSQL password
export PGDATABASE="${POSTGRES_DB:-postgres}"        # Default database name


# =============================================================================
# MAIN FUNCTION
#
# Main execution flow for the recreate command.
#
# Description:
#   Drops and recreates a PostgreSQL database. This is useful for resetting
#   a database to a clean state, often before restoring a backup or running
#   tests. The command will:
#   1. Verify the database exists
#   2. Prompt for confirmation (unless --force is used)
#   3. Drop the existing database
#   4. Create a new empty database with the same name
#
# Arguments:
#   $1 - DATABASE_NAME: Name of the database to recreate (optional)
#
# Options:
#   -d, --dbname NAME   Database name to recreate (overrides positional arg)
#   -u, --username USER PostgreSQL username (overrides POSTGRES_USER)
#   -p, --password PASS PostgreSQL password (overrides POSTGRES_PASSWORD)
#   -f, --force         Skip confirmation prompt
#   -h, --help          Display this help message
#
# Environment Variables:
#   POSTGRES_HOST       Database host (default: localhost)
#   POSTGRES_PORT       Database port (default: 5432)
#   POSTGRES_USER       Database user (default: postgres)
#   POSTGRES_PASSWORD   Database password (required)
#   POSTGRES_DB         Default database (default: postgres)
#
# Returns:
#   0 - Database recreated successfully
#   1 - Invalid arguments or missing credentials
#   2 - Operation failed
# -----------------------------------------------------------------------------
main() {
    local username=""
    local password=""
    local db_name=""
    local force=false

    # -------------------------------------------------------------------------
    # Parse Command Line Arguments
    # -------------------------------------------------------------------------
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;

            -u|--username)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--username' requires an argument"
                    return 1
                fi
                username="$2"
                shift 2
                ;;

            -p|--password)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--password' requires an argument"
                    return 1
                fi
                password="$2"
                shift 2
                ;;

            -d|--dbname)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--dbname' requires an argument"
                    return 1
                fi
                db_name="$2"
                shift 2
                ;;

            -f|--force)
                force=true
                shift
                ;;

            --)
                shift
                if [[ -z "$db_name" && -n "$1" ]]; then
                    db_name="$1"
                fi
                break
                ;;

            -*)
                alenaal_error "Unknown option: $1"
                alenaal_suggestion "Use 'yarsin recreate --help' for usage information"
                return 1
                ;;

            *)
                if [[ -z "$db_name" ]]; then
                    db_name="$1"
                else
                    alenaal_error "Unexpected argument: $1"
                    return 1
                fi
                shift
                ;;
        esac
    done

    # -------------------------------------------------------------------------
    # Set Credentials
    # -------------------------------------------------------------------------
    if [[ -n "$username" && -n "$password" ]]; then
        export PGUSER="${username}"
        export PGPASSWORD="${password}"
    elif [[ -n "$username" || -n "$password" ]]; then
        alenaal_error "Both username and password must be provided together"
        return 1
    fi

    # Check if the PGUSER is 'postgres' and display a warning
    if [[ "${PGUSER}" == "postgres" ]]; then
        alenaal_warning "Operating as 'postgres' superuser is not recommended"
        alenaal_suggestion "Create a dedicated user with appropriate permissions"
    fi

    # -------------------------------------------------------------------------
    # Get Database Name
    # -------------------------------------------------------------------------
    if [[ -z "$db_name" ]]; then
        alenaal_newline
        alenaal_format "Enter the name of the database to recreate:" --step
        list_databases
        alenaal_ask "Database name: " --indent 2
        read -r db_name

        if [[ -z "$db_name" ]]; then
            alenaal_error "No database name provided"
            return 1
        fi
    fi

    # -------------------------------------------------------------------------
    # Verify Database Exists
    # -------------------------------------------------------------------------
    if ! _database_exists "$db_name"; then
        alenaal_error "Database '$db_name' does not exist"
        alenaal_suggestion "Use 'yarsin bumng list' to see available backups"
        alenaal_suggestion "Use 'yarsin recreate' without arguments to list databases"
        return 2
    fi

    # -------------------------------------------------------------------------
    # Confirm Operation
    # -------------------------------------------------------------------------
    if [[ "$force" != true ]]; then
        alenaal_newline
        _show_database_info "$db_name"
        alenaal_newline
        alenaal_alarm "This will DESTROY and RECREATE database: $db_name" --indent 2
        alenaal_alarm "All data in this database will be PERMANENTLY LOST!" --indent 2
        alenaal_ask "Are you sure you want to continue? (type 'yes' to confirm): " --indent 2
        read -r confirmation

        if [[ "$confirmation" != "yes" ]]; then
            alenaal_newline
            alenaal_cancel "Operation cancelled by user"
            alenaal_newline
            return 0
        fi
    fi

    # -------------------------------------------------------------------------
    # Drop Existing Database
    # -------------------------------------------------------------------------
    alenaal_newline
    alenaal_info "Dropping database '$db_name'..." --indent 2
    
    # Terminate existing connections
    _terminate_connections "$db_name"
    
    if ! dropdb "$db_name" 2>/dev/null; then
        alenaal_error "Failed to drop database '$db_name'"
        alenaal_suggestion "Check permissions and ensure no active connections"
        return 2
    fi
    alenaal_success "Database dropped successfully." --indent 2

    # -------------------------------------------------------------------------
    # Create New Database
    # -------------------------------------------------------------------------
    alenaal_info "Creating database '$db_name'..." --indent 2
    if ! createdb --owner="${PGUSER}" "$db_name" 2>/dev/null; then
        alenaal_error "Failed to create database '$db_name'"
        return 2
    fi
    alenaal_success "Database created successfully." --indent 2

    # -------------------------------------------------------------------------
    # Verify Creation
    # -------------------------------------------------------------------------
    if _database_exists "$db_name"; then
        alenaal_newline
        alenaal_complete "Database '$db_name' has been recreated successfully" --bold
        alenaal_format "The database is now empty and ready for use" --indent 2 --color blue
        alenaal_newline
    else
        alenaal_error "Database verification failed - database does not exist after creation"
        return 2
    fi

    return 0
}


