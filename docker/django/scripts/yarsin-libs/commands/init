# -----------------------------------------------------------------------------
# Function: _generate_setting_file
#
# Creates an environment-specific Django settings file.
#
# Args:
#   $1 - environment: Environment name (development, production, testing)
#   $2 - project_name: Name of the Django project
#   $3 - project_dir: Base directory for the project
#
# Returns:
#   0 - File created successfully
#   1 - File creation failed
# -----------------------------------------------------------------------------
_generate_setting_file() {
    local environment="$1"
    local project_name="$2"
    local project_dir="$3"

    local filepath="${project_dir}/${project_name}/settings/${environment}.py"

    # Ensure directory exists
    if [[ ! -d "$project_dir" ]]; then
        alenaal_error "Project directory does not exist: $project_dir"
        return 1
    fi

    # Check if file already exists
    if [[ -f "$filepath" ]]; then
        alenaal_warning "Settings file already exists, skipping: $filepath"
        return 0
    fi

    # Write the settings file
    cat > "$filepath" << EOF
"""${environment^} Environment Settings.

Environment: ${environment}
Inherits: .base
Overrides: Base settings as needed for '${environment}' operations

Key Responsibilities:
    1. Environment-specific configuration overrides
    2. Security settings appropriate for '${environment}'
    3. Service endpoints and credentials for '${environment}'

Configuration Method:
    - Set DJANGO_SETTINGS_MODULE="${project_name}.settings.${environment}"
    - Use environment variables for sensitive data
    - Extend/override only what's necessary from base settings

Note: This file is auto-generated. Manual edits may be overwritten.
"""

from .base import *  # pylint: disable=unused-wildcard-import, wildcard-import  # noqa

# ${environment^} specific settings
# Add your ${environment}-only settings below
EOF

   return 0
}

# -----------------------------------------------------------------------------
# Function: _generate_urls_file
#
# Creates an environment-specific URL configuration file.
#
# Args:
#   $1 - environment: Environment name (development, production, testing)
#   $2 - project_name: Name of the Django project
#   $3 - project_dir: Base directory for the project
#
# Returns:
#   0 - File created successfully
#   1 - File creation failed
# -----------------------------------------------------------------------------
_generate_urls_file() {
    local environment="$1"
    local project_name="$2"
    local project_dir="$3"

    local filepath="${project_dir}/${project_name}/urls/${environment}.py"

    # Ensure directory exists
    if [[ ! -d "$project_dir" ]]; then
        alenaal_error "Project directory does not exist: $project_dir"
        return 1
    fi

    # Determine environment-specific info
    local env_title="${environment^}"
    local purpose=""

    case "$environment" in
        development) purpose="Full debugging and development tools" ;;
        staging) purpose="QA testing with controlled access" ;;
        production) purpose="Public endpoints with security hardening" ;;
        testing) purpose="Automated test execution" ;;
        *) purpose="Custom ${environment} configuration" ;;
    esac

    # Check if file already exists
    if [[ -f "$filepath" ]]; then
        alenaal_warning "URLs file already exists, skipping: $filepath"
        return 0
    fi

    cat > "$filepath" <<EOF
"""${env_title} URL Configuration.

Environment: ${environment}
Purpose: ${purpose}
Inherits: .base.urlpatterns
Security: Review access controls before deployment

Usage: Add ${environment}-specific patterns below. All access should be logged.
"""

from .base import urlpatterns as base_urlpatterns


urlpatterns = base_urlpatterns + [
    # ${env_title}-specific patterns
    # Apply appropriate authentication/authorization
]
EOF

    return 0
}

