####################################################
#           Project Environment Settings           #
####################################################

# Runtime Versions
# ----------------
NGINX_VERSION=stable            # nginx release channel
PYTHON_VERSION=3.14             # Python interpreter version
POSTGRES_VERSION=18             # PostgreSQL database version
PGADMIN_TAG=dpage/pgadmin4      # pgAdmin4 container image tag

# Django Configuration
# --------------------
PROJECT_NAME=configs            # Root configuration directory for Django project

# Application Structure
# ---------------------
APP_DIRECTORY=apps              # Project-specific business logic applications
PACK_DIRECTORY=djansin          # Reusable packages across multiple projects
EXTRAS_DIRECTORY=contrib        # Auxiliary Django apps for management commands and utilities

# File Storage Paths
# ------------------
STATIC_ROOT=/assets/static      # Absolute path for collected static files
MEDIA_ROOT=/assets/media        # Absolute path for user-uploaded media files

# Container Configuration
# -----------------------
USERNAME=hakhsin                # Default non-root user inside containers

# Docker Compose Settings
# -----------------------
COMPOSE_PROJECT_NAME=djansin    # Prefix for container and network names

# Development Server
# ------------------
SERVER_PORT=9000                # Host port bound to Django development server

# PyPI package index URL
# ----------------------
# Common mirrors:
#   - Default:  https://pypi.org/simple/
#   - China:    https://mirrors.aliyun.com/pypi/simple/
#   - Europe:   https://mirrors.bfsu.edu.cn/pypi/web/simple/
#   - Iran:     https://mirror-pypi.runflare.com/simple/
#   - Iran:     https://package-mirror.liara.ir/repository/pypi/simple/
#   - Iran:     http://mirrors.aliyun.com/pypi/simple/
PYPI_MIRROR=https://pypi.org/simple/

# APT package mirror URL
# ----------------------
# Common mirrors:
#  - Default:  http://deb.debian.org/debian
#  - China:    http://mirrors.tuna.tsinghua.edu.cn/debian     
#  - USA:      http://ftp.us.debian.org/debian
#  - Iran:     http://mirror-linux.runflare.com/debian
#  - Iran:     http://mirror.iranserver.com/debian
#  - Iran:     http://mirror.arvancloud.ir/debian
#  - Iran:     http://repo.iut.ac.ir/debian
#  - Iran:     http://mirror.shatel.ir/debian
APT_MIRROR=http://deb.debian.org/debian

# Bypass APT validity checks. ⚠️ Insecure - temporary workaround only.
# --------------------------------------------------------------------
SKIP_SEC_EXPIRY=false
