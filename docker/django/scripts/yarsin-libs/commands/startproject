#!/usr/bin/env bash

# =============================================================================
# Command: startproject
# Description: Create a new Django project with optimized structure
#
# Author: Mohammad Ali Amini
# Date: 2026
# =============================================================================

# -----------------------------------------------------------------------------
# COMMAND METADATA
# -----------------------------------------------------------------------------
# This metadata is used by yarsin for command discovery and help display.
# Each field provides information about the command's purpose and usage.
# -----------------------------------------------------------------------------
declare -rA CMD_METADATA=(
    [name]="startproject"
    [category]="django"
    [description]="Create a new Django project with optimized structure"
    [usage]="yarsin startproject [PROJECT_NAME] [OPTIONS]"
    [version]="1.0.0"
    [requires]="python django-admin"
)


# =============================================================================
# EXECUTION GUARD
# =============================================================================
# Prevents direct execution of the command script. Ensures the command is only
# executed through the yarsin dispatcher, which provides the necessary
# environment and library loading.
#
# This guard checks two conditions:
#   1. Script is not being executed directly (sourced by yarsin)
#   2. Script is running within yarsin context (__YARSIN__ flag is set)
#
# Returns:
#   Non-zero exit code with error message if executed directly
# -----------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This command cannot be executed directly." >&2
    exit 1
elif [[ "${__YARSIN__}" != true ]]; then
    echo "Error: This command must be executed through yarsin dispatcher" >&2
    echo "Please use 'yarsin $(basename "${BASH_SOURCE[0]}") [OPTIONS]' instead." >&2
    exit 1
fi


# =============================================================================
# CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Strict Mode Configuration
# -----------------------------------------------------------------------------
# Enforces strict error handling to prevent silent failures and ensure
# predictable script behavior.
# -----------------------------------------------------------------------------
set -o errexit  # Exit script immediately if a command fails
set -o pipefail # Exit script when a command in a pipeline fails
set -o nounset  # Treat unset variables as errors


# =============================================================================
# MAIN FUNCTION
#
# Main execution flow for the startproject command.
#
# Description:
#   Creates a new Django project in the configured work directory.
#   Uses intelligent defaults: project name from argument, environment,
#   or falls back to 'configs'.
#
# Arguments:
#   PROJECT_NAME - Name of the Django project (optional)
#                 Default: ${PROJECT_NAME:-configs}
#
# Options:
#   -n, --name NAME   Project name (overrides positional argument)
#   -h, --help        Display this help message
#
# Environment Variables:
#   WORK_DIRECTORY    Base directory for project creation (required)
#   PROJECT_NAME      Default project name if not specified
#
# Returns:
#   0 - Project created successfully
#   1 - Missing required arguments or invalid options
#   2 - Project creation failed
# -----------------------------------------------------------------------------
main() {
    local project_name=""
    local project_dir="${WORK_DIRECTORY:-}"

    # -------------------------------------------------------------------------
    # Parse Command Line Arguments
    # -------------------------------------------------------------------------
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;
            
            -n|--name)
                if [[ -z "$2" ]]; then
                    alenaal_error "Option '--name' requires an argument"
                    return 1
                fi
                if [[ -n "$project_name" ]]; then
                    alenaal_error "Project name already specified: '${project_name}'"
                    return 1
                fi
                project_name="$2"
                shift 2
                ;;

            --)
                shift
                if [[ -z "$project_name" && -n "$1" ]]; then
                    project_name="$1"
                fi
                break
                ;;

            -*)
                alenaal_error "Unknown option: '$1'"
                alenaal_suggestion "Use 'yarsin startproject --help' for usage information"
                return 1
                ;;

            *)
                if [[ -n "$project_name" ]]; then
                    alenaal_error "Multiple project names specified: '${project_name}' and '$1'"
                    return 1
                fi
                project_name="$1"
                shift
                ;;
        esac
    done

    # -------------------------------------------------------------------------
    # Validate Inputs
    # -------------------------------------------------------------------------
    # Set default project name if not provided
    project_name="${project_name:-${PROJECT_NAME:-configs}}"
    
    # Validate WORK_DIRECTORY is set
    if [[ -z "${project_dir}" ]]; then
        alenaal_error "WORK_DIRECTORY environment variable is not set"
        alenaal_suggestion "Set WORK_DIRECTORY to the desired project location"
        alenaal_suggestion "Example: export WORK_DIRECTORY=/path/to/projects"
        return 1
    fi

    # Validate project directory exists
    if [[ ! -d "${project_dir}" ]]; then
        if ! mkdir -p "${project_dir}"; then
            alenaal_error "Failed to create project directory: ${project_dir}"
            return 2
        fi
    fi

    # Check if project already exists
    if [[ -d "${project_dir}/${project_name}" ]]; then
        alenaal_error "Project '${project_name}' already exists at: ${project_dir}/${project_name}"
        alenaal_suggestion "Use a different project name or remove the existing directory"
        return 2
    fi

    # -------------------------------------------------------------------------
    # Create Django Project
    # -------------------------------------------------------------------------
    alenaal_info "Creating Django project '${project_name}' in ${project_dir}"
    
    if ! django-admin startproject "${project_name}" "${project_dir}" 2>/dev/null; then
        alenaal_error "Failed to create Django project: ${project_name}"
        return 2
    fi

    alenaal_success "Django project '${project_name}' created successfully"
    alenaal_info "Project location: ${project_dir}/${project_name}"
    
    return 0
}


# =============================================================================
# HELP FUNCTION
#
# Displays comprehensive help for the startproject command.
#
# Provides detailed information about creating Django projects with
# proper configuration and best practices.
# -----------------------------------------------------------------------------
show_help() {
    alenaal_newline
    alenaal_format "startproject - Create Django Project" --header --icon "🏗️ "

    # -------------------------------------------------------------------------
    # Description Section
    # -------------------------------------------------------------------------
    alenaal_format "Description:" --section --description
    alenaal_format "${CMD_METADATA[description]}" --item
    alenaal_format "Creates a new Django project in the configured WORK_DIRECTORY" --item
    alenaal_format "with intelligent defaults and validation." --item --newline

    # -------------------------------------------------------------------------
    # Usage Section
    # -------------------------------------------------------------------------
    alenaal_format "Usage:" --section --usage
    alenaal_format "${CMD_METADATA[usage]}" --item --icon "⇢"
    alenaal_format "yarsin startproject myproject" --item --icon "⇢"
    alenaal_format "yarsin startproject --name myproject" --item --icon "⇢"
    alenaal_format "PROJECT_NAME=myproject yarsin startproject" --item --icon "⇢"
    alenaal_newline

    # -------------------------------------------------------------------------
    # Options Section
    # -------------------------------------------------------------------------
    alenaal_format "Options:" --section --option

    alenaal_format  --item --list --bold -- "-n, --name NAME"
    alenaal_format "Project name (overrides positional argument and PROJECT_NAME)" --indent 4

    alenaal_format --item --list --bold -- "-h, --help"
    alenaal_format "Display this help message" --indent 4
    alenaal_newline

    # -------------------------------------------------------------------------
