#!/usr/bin/env bash

# =============================================================================
# Command: init
# Description: Copy example environment files by removing the "example." prefix
#
# Author: Mohammad Ali Amini
# Date: 2026
# =============================================================================

# -----------------------------------------------------------------------------
# COMMAND METADATA
# -----------------------------------------------------------------------------
# This metadata is used by yarsin for command discovery and help display.
# Each field provides information about the command's purpose and usage.
# -----------------------------------------------------------------------------
declare -rA CMD_METADATA=(
    [name]="init"
    [category]="project"
    [description]="Copy example environment files by stripping the 'example.' prefix"
    [usage]="yarsin init [OPTIONS]"
    [version]="1.0.0"
    [requires]=""
)


# =============================================================================
# EXECUTION GUARD
# =============================================================================
# Prevents direct execution of the command script. Ensures the command is only
# executed through the yarsin dispatcher, which provides the necessary
# environment and library loading.
# -----------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This command cannot be executed directly." >&2
    exit 1
elif [[ "${__YARSIN__}" != true ]]; then
    echo "Error: This command must be executed through yarsin dispatcher" >&2
    echo "Please use 'yarsin $(basename "${BASH_SOURCE[0]}") [OPTIONS]' instead." >&2
    exit 1
fi


# =============================================================================
# CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Strict Mode Configuration
# -----------------------------------------------------------------------------
set -o errexit
set -o pipefail
set -o nounset

# -----------------------------------------------------------------------------
# Default Configuration
# -----------------------------------------------------------------------------
# PROJECT_PATH is provided by the yarsin dispatcher and points to the project
# root. The environment directory defaults to <project-root>/envs.
# -----------------------------------------------------------------------------
: "${ENV_DIR:=${PROJECT_PATH}/envs}"

# File pattern to look for in the environment directory
: "${ENV_PATTERN:=example.env.*}"

# Overwrite existing target files (0 = skip, 1 = overwrite)
: "${ENV_FORCE:=0}"


# =============================================================================
# MAIN FUNCTION
#
# Main execution flow for the init command.
#
# Description:
#   Copies all example environment files from the environment directory to
#   their real counterparts by removing the "example." prefix.
#   For example: example.env.api -> .env.api
#
#   By default, files are read from <project-root>/envs and written alongside
#   them. Use --dir to override the source directory.
#
# Options:
#   -h, --help          Display this help message
#   -d, --dir <path>    Specify environment directory (default: <root>/envs)
#   -f, --force         Overwrite existing target files
#
# Environment Variables:
#   ENV_DIR       Environment files directory (default: <project-root>/envs)
#   ENV_PATTERN   Glob pattern to match example files (default: example.env.*)
#   ENV_FORCE     Whether to overwrite existing files: 0 or 1 (default: 0)
#
# Returns:
#   0 - Environment files initialized successfully
#   1 - Invalid arguments
#   2 - Initialization failed
# =============================================================================
main() {
    # -------------------------------------------------------------------------
    # Parse Command Line Arguments
    # -------------------------------------------------------------------------
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;
            -d|--dir)
                if [[ -z "${2:-}" ]]; then
                    alenaal_error "Option --dir requires a path argument"
                    return 1
                fi
                ENV_DIR="$2"
                shift 2
                ;;
            --dir=*)
                ENV_DIR="${1#*=}"
                shift
                ;;
            -f|--force)
                ENV_FORCE=1
                shift
                ;;
            --)
                shift
                break
                ;;
            -*)
                alenaal_error "Unknown option: $1"
                alenaal_suggestion "Use 'yarsin init --help' for usage information"
                return 1
                ;;
            *)
                alenaal_error "Unexpected argument: $1"
                alenaal_suggestion "Use 'yarsin init --help' for usage information"
                return 1
                ;;
        esac
    done

    # -------------------------------------------------------------------------
    # Normalize ENV_DIR to an absolute path
    # -------------------------------------------------------------------------
    # Relative paths (from --dir or ENV_DIR env var) are resolved against the
    # project root, not the current working directory. This makes behavior
    # consistent no matter where yarsin is invoked from.
    # -------------------------------------------------------------------------
    if [[ "${ENV_DIR}" != /* ]]; then
        ENV_DIR="${PROJECT_PATH}/${ENV_DIR#./}"
    fi

    # -------------------------------------------------------------------------
    # Step 1: Copy Environment Files
    # -------------------------------------------------------------------------
    alenaal_info "Initializing environment files from: ${ENV_DIR}"
    local status=0
    _copy_env_files "${ENV_DIR}" || status=$?

    # -------------------------------------------------------------------------
    # Completion Message
    # -------------------------------------------------------------------------
    alenaal_newline
    if [[ $status -eq 0 ]]; then
        alenaal_success "Environment file initialization completed!"
        alenaal_info "Next steps:"
        alenaal_format "1. Review and update environment files in ${ENV_DIR}/" --indent 2
        alenaal_format "2. Ensure secrets and credentials are properly set" --indent 2
        alenaal_newline
        return 0
    else
        alenaal_error "Environment file initialization failed"
        return 2
    fi
}


