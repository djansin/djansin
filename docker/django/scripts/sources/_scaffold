# ------------------------------
# Generate admin.py
# ------------------------------
generate_admin_py() {
    local app_name="$1"
    local file_path="$2"

    cat > "$file_path" <<EOF
"""
admin.py
---------

Register models of $(to_capitalize "${app_name}") app to Django admin interface.

Best Practices:
    - Always use ModelAdmin to customize the admin interface.
    - Avoid heavy logic; keep admin focused on registration and display.
    - Use list_display, search_fields, and list_filter for usability.

Examples (Cheat Sheet):
    from django.contrib import admin
    from .models import MyModel

    # Example of registering a model manually
    admin.site.register(MyModel)

    @admin.register(MyModel)
    class MyModelAdmin(admin.ModelAdmin):
        list_display = ('id', 'name', 'created_at')
        search_fields = ('name',)
        list_filter = ('status',)
"""

# from django.contrib import admin
# from .models import *
EOF
}

# ------------------------------
# Generate apps.py
# ------------------------------
generate_apps_py() {
    local app_name="$1"
    local file_path="$2"

    # Determine AppConfig.name value
    local app_config_name
    if [ -n "${APPS_DIRECTORY:-}" ]; then
        app_config_name="${APPS_DIRECTORY}.${app_name}"
    else
        app_config_name="${app_name}"
    fi

    cat > "$file_path" <<EOF
"""
apps.py
-------

Configuration for the $(to_capitalize "${app_name}") app.

This file defines the AppConfig class, which registers the app with Django
and provides essential metadata for administration and initialization.

Guidelines and Best Practices:
    1. App Identification:
        - Set 'name' to the correct Python path (e.g., '${app_config_name}')
          to ensure Django recognizes the app.
        - Maintain consistent naming conventions across all apps.
    2. Administration:
        - Use 'verbose_name' for a human-readable name in admin interfaces.
        - Keep AppConfig focused on configuration; avoid business logic here.
    3. Models:
        - Always define 'default_auto_field' to specify the default primary key type.
    4. Maintainability:
        - Keep AppConfig classes simple and clean for easier project scaling.
        - Avoid redundant or unnecessary attributes.

"""

from django.apps import AppConfig


class $(to_capitalize "${app_name}")Config(AppConfig):
    """
    AppConfig class for the $(to_capitalize "${app_name}") application.

    Provides metadata for Django to properly initialize and manage the app.

    Key Attributes:
        - name: Python path of the app for registration.
        - verbose_name: Human-readable app name for admin interfaces.
        - default_auto_field: Default primary key type for models.
    """

    default_auto_field = 'django.db.models.BigAutoField'
    name = "${app_config_name}"
    verbose_name = "$(to_capitalize "${app_name}") Application"
EOF
}

