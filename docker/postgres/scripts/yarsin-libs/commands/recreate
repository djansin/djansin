# =============================================================================
# COMMAND FUNCTIONS
# =============================================================================
# Private helper functions for database operations.
# These functions are prefixed with underscore to indicate internal use.
# =============================================================================

# -----------------------------------------------------------------------------
# Function: _database_exists
#
# Checks if a database exists.
#
# Args:
#   $1 - db_name: Database name to check
#
# Returns:
#   0 if database exists, 1 otherwise
# -----------------------------------------------------------------------------
_database_exists() {
    local db_name="$1"

    if [[ -z "$db_name" ]]; then
        return 1
    fi

    psql -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = '$db_name'" | grep -q 1
    return $?
}

# -----------------------------------------------------------------------------
# Function: _show_database_info
#
# Shows information about a database.
#
# Args:
#   $1 - db_name: Database name
# -----------------------------------------------------------------------------
_show_database_info() {
    local db_name="$1"

    alenaal_format "Database Information:" --subsection

    # Get database size
    local db_size
    db_size=$(psql -d postgres -tAc "SELECT pg_size_pretty(pg_database_size('$db_name'));" 2>/dev/null || echo "unknown")

    # Get owner
    local db_owner
    db_owner=$(psql -d postgres -tAc "SELECT pg_catalog.pg_get_userbyid(datdba) FROM pg_database WHERE datname = '$db_name';" 2>/dev/null || echo "unknown")

    # Get connection count
    local connections
    connections=$(psql -d postgres -tAc "SELECT count(*) FROM pg_stat_activity WHERE datname = '$db_name';" 2>/dev/null || echo "0")

    alenaal_format "Name:         $db_name" --item --indent 4
    alenaal_format "Size:         $db_size" --item --indent 4
    alenaal_format "Owner:        $db_owner" --item --indent 4
    alenaal_format "Connections:  $connections" --item --indent 4
}

# -----------------------------------------------------------------------------
# Function: _terminate_connections
#
# Terminates all connections to a database.
#
# Args:
#   $1 - db_name: Database name
# -----------------------------------------------------------------------------
_terminate_connections() {
    local db_name="$1"

    alenaal_info "Terminating connections to '$db_name'..." --indent 2

    # Try different methods based on PostgreSQL version
    if psql -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$db_name' AND pid <> pg_backend_pid();" &>/dev/null; then
        alenaal_success "Connections terminated" --indent 2
    else
        # Fallback for older PostgreSQL versions
        psql -d postgres -c "SELECT pg_terminate_backend(procpid) FROM pg_stat_activity WHERE datname = '$db_name' AND procpid <> pg_backend_pid();" &>/dev/null && \
            alenaal_success "Connections terminated" --indent 2 || \
            alenaal_warning "Could not terminate some connections" --indent 2
    fi
}


# =============================================================================
# METADATA HANDLER LOADING
# =============================================================================
