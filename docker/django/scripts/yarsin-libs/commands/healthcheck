# =============================================================================
# COMMAND FUNCTIONS
# =============================================================================
# Private helper functions that implement specific health checks.
# These functions are prefixed with underscore to indicate they are internal.
# All functions are designed to be silent and return appropriate exit codes.
# =============================================================================

# -----------------------------------------------------------------------------
# Function: _check_port_listening
#
# Checks if the server port is in LISTEN state.
#
# Description:
#   Verifies that a process is actively listening on the specified port.
#   This is more fundamental than HTTP responsiveness as it checks TCP-level
#   availability without requiring the HTTP server to be fully functional.
#
# Args:
#   $1 - port: Server port number to check
#
# Returns:
#   0 if port is in LISTEN state
#   1 if port is not listening or connection times out
#
# Implementation:
#   Uses bash's built-in /dev/tcp redirection which creates a TCP connection.
#   This is more efficient than external tools like netstat or ss.
# -----------------------------------------------------------------------------
_check_port_listening() {
    local port="$1"
    
    if timeout "${TIMEOUT}" bash -c "echo >/dev/tcp/localhost/${port}" 2>/dev/null; then
        return 0
    fi

    alenaal_debug "Port ${port} is not in LISTEN state"
    return 1
}

# -----------------------------------------------------------------------------
# Function: _check_server_responding
#
# Tests server HTTP responsiveness by attempting to connect to health endpoints.
#
# Description:
#   Verifies that the server accepts HTTP connections and returns successful
#   responses. Attempts to connect to a list of health endpoints in order of
#   preference. The first successful endpoint determines success.
#
# Args:
#   $1 - port: Server port number
#   $2 - timeout: Request timeout in seconds
#
# Returns:
#   0 if any endpoint responds successfully
#   1 if all endpoints fail to respond
#
# Note:
#   The endpoint list is configurable via HEALTH_ENDPOINTS array.
# -----------------------------------------------------------------------------
_check_server_responding() {
    local port="$1"
    local timeout="$2"
    
    for endpoint in "${HEALTH_ENDPOINTS[@]}"; do
        if curl -s -f -o /dev/null \
           --max-time "${timeout}" \
           "http://localhost:${port}${endpoint}" 2>/dev/null; then
            return 0
        fi
    done
    
    alenaal_debug "Server not responding on port ${port}"
    return 1
}

# -----------------------------------------------------------------------------
# Function: _check_django_importability
#
# Verifies Django importability and basic configuration.
#
# Description:
#   Checks that Django can be imported and configured with the specified
#   settings module. This fundamental check ensures the Python environment
#   is properly set up before more advanced checks are attempted.
#
# Returns:
#   0: Django successfully imported and configured
#   1: Django import or configuration failed
#
# Implementation:
#   Uses a Python one-liner to import Django and call django.setup().
#   All output is suppressed to maintain silent operation.
# -----------------------------------------------------------------------------
_check_django_importability() {
    python3 - <<'EOF' 2>/dev/null || return 1
import os
import sys
import django

# Configure Django settings module
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'configs.settings')

try:
    django.setup()
except Exception:
    sys.exit(1)
EOF
}

# -----------------------------------------------------------------------------
# Function: _check_django_system
#
# Runs Django system checks with deployment-focused validation.
#
# Description:
#   Executes Django's built-in system checks with the --deploy flag,
#   performing security and performance checks appropriate for production
#   environments. This helps identify misconfigurations before deployment.
#
# Returns:
#   0: All system checks passed
#   1: System checks failed or errors detected
#
# Note:
#   The --deploy flag enables additional checks that are not run by default.
# -----------------------------------------------------------------------------
_check_django_system() {
    python3 - <<'EOF' 2>/dev/null || return 1
import os
import sys
import django
from django.core.management import execute_from_command_line

os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'configs.settings')
django.setup()

try:
    execute_from_command_line(['manage.py', 'check', '--deploy'])
except SystemExit as e:
    if e.code != 0:
        sys.exit(1)
EOF
}

# -----------------------------------------------------------------------------
# Function: _check_database_connectivity
#
# Tests connectivity to all configured database connections.
#
# Description:
#   Attempts to establish a cursor connection to each database configured in
#   Django's DATABASES setting. Validates that database servers are reachable
#   and credentials are correct for all connections, not just 'default'.
#
# Returns:
#   0: All database connections successful
#   1: One or more database connections failed
# -----------------------------------------------------------------------------
_check_database_connectivity() {
    python3 - <<'EOF' 2>/dev/null || return 1
import os
import sys
import django
from django.db import connections
from django.db.utils import OperationalError

os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'configs.settings')
django.setup()

# Test each database connection
for conn_name in connections:
    try:
        connections[conn_name].cursor()
    except OperationalError:
        sys.exit(1)
EOF
}

# -----------------------------------------------------------------------------
# Function: _check_pending_migrations
#
# Checks for unapplied database migrations.
#
# Description:
#   Examines the migration history and identifies any migrations that have
#   been created but not yet applied to the database. This check helps
#   prevent schema inconsistencies between code and database.
#
# Returns:
#   0: No pending migrations
#   1: Pending migrations detected or check failed
#
# Note:
#   This check does not apply migrations, only detects pending ones.
# -----------------------------------------------------------------------------
_check_pending_migrations() {
    python3 - <<'EOF' 2>/dev/null || return 1
import os
import sys
import django

os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'configs.settings')
django.setup()

try:
    from django.db.migrations.executor import MigrationExecutor
    from django.db import connection
    
    executor = MigrationExecutor(connection)
    plan = executor.migration_plan(executor.loader.graph.leaf_nodes())
    
    if plan:
        sys.exit(1)
except Exception:
    sys.exit(1)
EOF
}


